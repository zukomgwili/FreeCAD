"""Run immutable native stock spring probe through the serial custody gate."""
import importlib.util
from pathlib import Path
import sys

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent
spec = importlib.util.spec_from_file_location("_baseline_guard", ROOT / "run_gate.py")
base = importlib.util.module_from_spec(spec)
spec.loader.exec_module(base)
base.core.SOURCE_FILES += (str(Path(__file__).resolve()), str(ROOT / "Sv7SpringBaseline.py"))
run = ROOT / "stock-spring-baseline"
base.core.COMMANDS = {"spring-baseline": [
    "/Applications/FreeCAD-27.1.0.app/Contents/MacOS/FreeCADCmd",
    "-u", str(run / "user.cfg"), "-s", str(run / "system.cfg"),
    "-P", str(ROOT), "-t", "Sv7SpringBaseline",
]}
if __name__ == "__main__":
    raise SystemExit(base.core.main())
