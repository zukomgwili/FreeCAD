 * Opt-in observation of native, unaveraged B32R end-section integrations.
 * The observer neither evaluates stresses/quadrature nor modifies mechanics,
 * native result arrays, output selections, convergence or ordinary files.
 */
#include <errno.h>
#include <limits.h>
#include <math.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include "CalculiX.h"

_Static_assert(sizeof(ITG) == sizeof(int), "Beam observation requires 32-bit native integers");

typedef struct
{
    ITG nodes[3];
    int declared;
} BSElement;

typedef struct
{
    ITG element, node, end;
    int seen, points;
    double position[3], e1[3], e2[3], normal[3];
    double force[3], moment[3], channels[6];
} BSSample;

typedef struct
{
    ITG node, direction, original_direction, role;
    double value, axis[3];
} BSSPC;

typedef struct
{
    int spring_seen, support_seen;
    size_t spc_count;
    double source[3], source_moment[3], spring[3], spring_moment[3];
    double displacement[3], support[3], support_moment[3];
    BSSPC spcs[9];
} BSActions;

typedef struct
{
    ITG step, increment, dataset;
    double time;
    BSSample* samples;
    BSActions actions;
} BSFrame;

typedef struct
{
    ITG original, direction, auxiliary;
    double axis[3];
} BSAngle;

static struct
{
    int active, capturing, mapping, mapped, pending, coupled, actions_capturing;
    ITG ne, nk, step, increment, action_step, action_increment;
    size_t count, frame_count;
    char* path;
    char request[33];
    double end_time, time, action_time;
    ITG spring_element, spring_node, spring_direction, source_node, support_node;
    int support_directions[6], pointloads_seen;
    char spring_owner[81], source_owner[81], support_owner[81];
    double *coordinates, *frame_displacements, pointload[3];
    BSActions actions;
    BSElement* elements;
    BSSample* samples;
    BSSample* current;
    BSFrame* frames;
} bs;

static struct
{
    int checked, enabled, input_seen;
    ITG input_mpcs;
    size_t count;
    BSAngle angles[3];
} bs_early;

static void bs_fail(const char* message)
{
    fprintf(stderr, "*ERROR CCX beam section V%d: %s\n", bs.coupled ? 2 : 1, message);
    fflush(stderr);
    exit(201);
}

static int bs_early_enabled(void)
{
    const char* path;
    FILE* stream;
    char schema[81];
    if (!bs_early.checked) {
        bs_early.checked = 1;
        path = getenv("CCX_BEAM_SECTION_REQUEST");
        stream = path && *path ? fopen(path, "r") : NULL;
        if (stream) {
            bs_early.enabled = fscanf(stream, "%80s", schema) == 1 &&
                               !strcmp(schema, "CCX_BEAM_SECTION_V2");
            fclose(stream);
        }
    }
    return bs_early.enabled;
}

void FORTRAN(bs_input_mpcs, (ITG* count))
{
    if (!bs_early_enabled()) {
        return;
    }
    if (bs_early.input_seen) {
        bs_fail("coupled beam observation supports one native mesh generation only");
    }
    bs_early.input_seen = 1;
    bs_early.input_mpcs = *count;
}

/* gen3dboun runs before the final expanded mesh and bs_prepare exist.
 * Retain only the native identities and axis values generated by its actual
 * mean-rotation branch. No solver array pointer survives reallocation. */
void FORTRAN(bs_record_angle, (ITG* original, ITG* direction, ITG* auxiliary, double* axis))
{
    size_t k;
    BSAngle* angle;
    if (!bs_early_enabled()) {
        return;
    }
    if (bs_early.count == 3) {
        bs_fail("coupled beam domain permits one endpoint with at most three rotations");
    }
    angle = bs_early.angles + bs_early.count++;
    angle->original = *original;
    angle->direction = *direction + 3;
    angle->auxiliary = *auxiliary;
    for (k = 0; k < 3; ++k) {
        angle->axis[k] = axis[k];
    }
}

static size_t bs_product(size_t left, size_t right)
{
    if (right && left > SIZE_MAX / right) {
        bs_fail("allocation dimension overflow");
    }
    return left * right;
}

static void* bs_allocate(size_t count, size_t size)
{
    void* result;
    bs_product(count, size);
    result = calloc(count ? count : 1, size);
    if (!result) {
        bs_fail("allocation failed");
    }
    return result;
}

static void bs_token(FILE* stream, char token[81])
{
    if (fscanf(stream, "%80s", token) != 1) {
        bs_fail("truncated request");
    }
}

static void bs_expect(FILE* stream, const char* wanted)
{
    char token[81];
    bs_token(stream, token);
    if (strcmp(token, wanted)) {
        bs_fail("unexpected request token");
    }
}

static ITG bs_integer(FILE* stream)
{
    char token[81];
    const unsigned char* p;
    unsigned long value = 0;
    bs_token(stream, token);
    if (*token < '1' || *token > '9') {
        bs_fail("node and element labels require canonical positive integers");
    }
    for (p = (const unsigned char*)token; *p; ++p) {
        if (*p < '0' || *p > '9' ||
            value > ((unsigned long)INT_MAX - (unsigned long)(*p - '0')) / 10) {
            bs_fail("node or element label overflow");
        }
        value = 10 * value + (unsigned long)(*p - '0');
    }
    return (ITG)value;
}

static char* bs_suffix(const char* suffix)
{
    size_t path_length = strlen(bs.path), suffix_length = strlen(suffix);
    char* result;
    if (path_length > SIZE_MAX - suffix_length - 1) {
        bs_fail("output path overflow");
    }
    result = bs_allocate(path_length + suffix_length + 1, 1);
    memcpy(result, bs.path, path_length);
    memcpy(result + path_length, suffix, suffix_length + 1);
    return result;
}

static void bs_absent(const char* path)
{
    struct stat info;
    errno = 0;
    if (!lstat(path, &info) || errno != ENOENT) {
        bs_fail("output and temporary paths must be fresh for this child");
    }
}

static void bs_finish(void)
{
    if (bs.active && (!bs.frame_count || bs.pending ||
                      bs.frames[bs.frame_count - 1].time != bs.end_time)) {
        fprintf(stderr, "*ERROR CCX beam section V%d: missing complete final native frame\n",
                bs.coupled ? 2 : 1);
        fflush(NULL);
        _Exit(201);
    }
}

static void bs_owner(FILE* stream, char owner[81])
{
    const unsigned char* p;
    bs_token(stream, owner);
    for (p = (const unsigned char*)owner; *p; ++p) {
        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') ||
              (*p >= '0' && *p <= '9') || *p == '_')) {
            bs_fail("coupled owner must be an unambiguous native identifier");
        }
    }
}

static void bs_cross(double* result, const double* position, const double* force)
{
    result[0] = position[1] * force[2] - position[2] * force[1];
    result[1] = position[2] * force[0] - position[0] * force[2];
    result[2] = position[0] * force[1] - position[1] * force[0];
    if (!isfinite(result[0]) || !isfinite(result[1]) || !isfinite(result[2])) {
        bs_fail("nonfinite native origin-moment transport");
    }
}

typedef struct
{
    double start, end;
    ITG first, last;
} BSInterval;

static int bs_interval_order(const void* left, const void* right)
{
    const BSInterval *a = left, *b = right;
    return (a->start > b->start) - (a->start < b->start);
}

static void bs_coupled_geometry(ITG* ipkon, ITG* kon, char* lakon,
                                ITG material_stride, ITG* materials)
{
    /* Matching native section corners, not oriented outward-face order. */
    static const int corners[3][4] = {{0, 4, 7, 3}, {8, 12, 14, 10}, {1, 5, 6, 2}};
    BSInterval* intervals = bs_allocate(bs.count, sizeof(BSInterval));
    ITG *roles = bs_allocate((size_t)bs.nk, sizeof(ITG));
    ITG element, k, side, corner, node, material = 0;
    size_t row = 0;
    double direction[3], length2 = 0., root[3], reference[2][3] = {{0.}};
    double point[3], projection[3], s[3], centroid[3], edges[2][3];
    double tolerance, length, error, norm, dot;
    if (bs.spring_node != bs.support_node || bs.source_node == bs.support_node ||
        bs.spring_node > bs.nk || bs.source_node > bs.nk || material_stride < 1) {
        bs_fail("coupled source and grounded support must be distinct original beam endpoints");
    }
    for (k = 0; k < 3; ++k) {
        root[k] = bs.coordinates[3 * (size_t)(bs.support_node - 1) + k];
        direction[k] = bs.coordinates[3 * (size_t)(bs.source_node - 1) + k] - root[k];
        length2 += direction[k] * direction[k];
    }
    if (!isfinite(length2) || length2 <= 0.) {
        bs_fail("coupled beam chain has no finite positive length");
    }
    length = sqrt(length2);
    tolerance = 1.e-8 * fmax(1., length);
    for (k = 0; k < 3; ++k) {
        if (k != bs.spring_direction - 1 && fabs(direction[k]) > tolerance) {
            bs_fail("coupled chain must follow its scalar global spring axis");
        }
    }
    for (element = 0; element < bs.ne; ++element) {
        BSElement* beam = bs.elements + element;
        if (!beam->declared) {
            continue;
        }
        if (lakon[8 * (size_t)element + 7] != 'R') {
            bs_fail("coupled beam diagnostics require native rectangular sections");
        }
        if (!material) {
            material = materials[(size_t)material_stride * element];
        }
        if (material < 1 || materials[(size_t)material_stride * element] != material) {
            bs_fail("coupled beam chain requires one native material assignment");
        }
        for (side = 0; side < 3; ++side) {
            node = beam->nodes[side];
            if (roles[node - 1] == 2 || (side == 1 && roles[node - 1])) {
                bs_fail("coupled chain has a reused midside or endpoint identity");
            }
            roles[node - 1] = side == 1 ? 2 : 1;
            s[side] = 0.;
            for (k = 0; k < 3; ++k) {
                point[k] = bs.coordinates[3 * (size_t)(node - 1) + k] - root[k];
                s[side] += point[k] * direction[k] / length2;
            }
            error = 0.;
            for (k = 0; k < 3; ++k) {
                projection[k] = point[k] - s[side] * direction[k];
                error += projection[k] * projection[k];
            }
            if (!isfinite(s[side]) || !isfinite(error) || error > tolerance * tolerance ||
                s[side] < -1.e-8 || s[side] > 1. + 1.e-8) {
                bs_fail("coupled original beam nodes are not one straight collinear chain");
            }
        }
        if (s[2] <= s[0] || fabs(s[1] - 0.5 * (s[0] + s[2])) > 1.e-8) {
            bs_fail("coupled segments require the source direction and centered midsides");
        }
        intervals[row] = (BSInterval){s[0], s[2], beam->nodes[0], beam->nodes[2]};
        for (side = 0; side < 3; ++side) {
            memset(centroid, 0, sizeof(centroid));
            for (corner = 0; corner < 4; ++corner) {
                node = kon[(size_t)ipkon[element] + corners[side][corner]];
                if (node < 1 || node > bs.nk) {
                    bs_fail("expanded native section node is outside the mesh");
                }
                for (k = 0; k < 3; ++k) {
                    centroid[k] += bs.coordinates[3 * (size_t)(node - 1) + k] / 4.;
                }
            }
            for (k = 0; k < 3; ++k) {
                if (fabs(centroid[k] - bs.coordinates[
                        3 * (size_t)(beam->nodes[side] - 1) + k]) > tolerance) {
                    bs_fail("coupled beam sections must have zero native offsets");
                }
                node = kon[(size_t)ipkon[element] + corners[side][0]];
                edges[0][k] = bs.coordinates[3 * (size_t)(kon[(size_t)ipkon[element] +
                                     corners[side][1]] - 1) + k] -
                              bs.coordinates[3 * (size_t)(node - 1) + k];
                edges[1][k] = bs.coordinates[3 * (size_t)(kon[(size_t)ipkon[element] +
                                     corners[side][3]] - 1) + k] -
                              bs.coordinates[3 * (size_t)(node - 1) + k];
                if (!row && !side) {
                    reference[0][k] = edges[0][k];
                    reference[1][k] = edges[1][k];
                }
                if (fabs(edges[0][k] - reference[0][k]) > tolerance ||
                    fabs(edges[1][k] - reference[1][k]) > tolerance) {
                    bs_fail("coupled native rectangular sections must be uniform and aligned");
                }
            }
            dot = norm = 0.;
            for (k = 0; k < 3; ++k) {
                dot += edges[0][k] * edges[1][k];
                norm += edges[0][k] * edges[0][k];
            }
            if (!isfinite(dot) || !isfinite(norm) || norm <= 0. ||
                fabs(dot) > tolerance * fmax(1., sqrt(norm))) {
                bs_fail("invalid coupled rectangular section geometry");
            }
        }
        ++row;
    }
    qsort(intervals, bs.count, sizeof(BSInterval), bs_interval_order);
    if (intervals[0].first != bs.support_node ||
        intervals[bs.count - 1].last != bs.source_node) {
        bs_fail("coupled source and support must be the chain endpoints");
    }
    for (row = 1; row < bs.count; ++row) {
        if (intervals[row].first != intervals[row - 1].last ||
            fabs(intervals[row].start - intervals[row - 1].end) > 1.e-8) {
            bs_fail("coupled beam catalogue is disconnected, overlapping or branched");
        }
    }
    free(intervals);
    free(roles);
}

static void bs_coupled_supports(ITG nboun, ITG* nodes, ITG* directions,
                                double* values, ITG* amplitudes, char* types)
{
    ITG i, j, node, dir;
    int found[6] = {0}, angle_found[3] = {0}, algebraic_found[3] = {0};
    size_t a;
    for (a = 0; a < bs_early.count; ++a) {
        BSAngle* angle = bs_early.angles + a;
        if (angle->original != bs.support_node || angle->direction < 4 ||
            angle->direction > 6 || !bs.support_directions[angle->direction - 1] ||
            angle->auxiliary < 1 || angle->auxiliary > bs.nk) {
            bs_fail("native mean-rotation support has no declared author constraint");
        }
        for (j = 0; j < 3; ++j) {
            if (!isfinite(angle->axis[j]) ||
                fabs(angle->axis[j] - (j == angle->direction - 4)) > 1.e-12) {
                bs_fail("native support rotation axis differs from the requested global DOF");
            }
        }
        for (j = 0; j < (ITG)a; ++j) {
            if (bs_early.angles[j].direction == angle->direction ||
                bs_early.angles[j].auxiliary == angle->auxiliary) {
                bs_fail("repeated native mean-rotation support identity");
            }
        }
    }
    for (i = 0; i < nboun; ++i) {
        node = nodes[i];
        dir = directions[i];
        if (node < 1 || node > bs.nk || dir < 1 || dir > 6 ||
            values[i] != 0. || (amplitudes && amplitudes[i])) {
            bs_fail("coupled supports require finite zero unamplified mechanical constraints");
        }
        if (node == bs.support_node && bs.support_directions[dir - 1]) {
            if (++found[dir - 1] != 1) {
                bs_fail("repeated original coupled support DOF");
            }
            continue;
        }
        for (a = 0; a < bs_early.count; ++a) {
            if (node == bs_early.angles[a].auxiliary && dir == 1) {
                if (++angle_found[a] != 1) {
                    bs_fail("repeated native angle support DOF");
                }
                break;
            }
            if (node == bs_early.angles[a].auxiliary && dir == 2 && types[i] == 'U') {
                if (++algebraic_found[a] != 1) {
                    bs_fail("repeated native algebraic support DOF");
                }
                break;
            }
        }
        if (a == bs_early.count) {
            bs_fail("native SPC is outside the sole declared physical beam support");
        }
    }
    for (j = 0; j < 6; ++j) {
        if (found[j] != bs.support_directions[j]) {
            bs_fail("declared original support DOF is missing from the native problem");
        }
    }
    for (a = 0; a < bs_early.count; ++a) {
        if (angle_found[a] != 1 || algebraic_found[a] != 1) {
            bs_fail("native angle/algebraic support pair is incomplete");
        }
    }
    if (bs_early.count != 3) {
        bs_fail("coupled beam chain requires all three declared native root rotations");
    }
}

void bs_prepare(ITG method, ITG* perturb, ITG thermal, ITG transforms,
                ITG cyclic, ITG step, ITG nk, ITG ne, ITG nkon,
                ITG* ipkon, ITG* kon, char* lakon, char* filab, double* co,
                ITG nboun, ITG* nodeboun, ITG* ndirboun, double* xboun,
                ITG* iamboun, char* typeboun, ITG nmpc, char* labmpc,
                ITG nload, ITG nbody, ITG ntie, ITG prestress,
                ITG material_stride, ITG* materials)
{
    const char* path = getenv("CCX_BEAM_SECTION_REQUEST");
    FILE* stream;
    char token[81], *tail, *output, *temporary;
    struct stat info;
    ITG element, node, k, index;
    int byte;
    size_t count = 0, springs = 0, i;
    if (!path) {
        return;
    }
    if (!*path || bs.active || strlen(path) > 4096) {
        bs_fail("requires a nonempty request path and one standalone step");
    }
    if (method != 1 || perturb[1] || thermal > 1 || transforms || cyclic || step != 1) {
        bs_fail("requires one small-displacement global mechanical static step");
    }
    if (nk < 1 || ne < 1 || nkon < 23 ||
        strncmp(filab + 174, "S   ", 4) || filab[178] != 'M' || filab[179] == 'L') {
        bs_fail("requires native B32R SECTION FORCES with global source stresses");
    }
    if (lstat(path, &info) || !S_ISREG(info.st_mode)) {
        bs_fail("request must be a regular non-symlink file");
    }
    bs.path = bs_allocate(strlen(path) + 1, 1);
    strcpy(bs.path, path);
    output = bs_suffix(".out");
    temporary = bs_suffix(".out.tmp");
    bs_absent(output);
    bs_absent(temporary);
    free(output);
    free(temporary);
    bs.ne = ne;
    bs.nk = nk;
    bs.elements = bs_allocate((size_t)ne, sizeof(BSElement));
    stream = fopen(path, "r");
    if (!stream) {
        bs_fail("cannot read request");
    }
    while ((byte = fgetc(stream)) != EOF) {
        if (!byte || (byte < 32 && byte != '\n' && byte != '\r' && byte != '\t')) {
            bs_fail("request contains a non-text byte");
        }
    }
    if (ferror(stream) || fseek(stream, 0, SEEK_SET)) {
        bs_fail("cannot inspect or rewind request");
    }
    bs_token(stream, token);
    if (!strcmp(token, "CCX_BEAM_SECTION_V2")) {
        bs.coupled = 1;
    }
    else if (strcmp(token, "CCX_BEAM_SECTION_V1")) {
        bs_fail("unsupported native beam request schema");
    }
    for (element = 0; element < ne; ++element) {
        if (ipkon[element] < 0) {
            continue;
        }
        if (bs.coupled && !strncmp(lakon + 8 * (size_t)element, "ESPRNG10", 8)) {
            if (ipkon[element] >= nkon || ++springs != 1) {
                bs_fail("coupled beam request requires exactly one native grounded SPRING1");
            }
            continue;
        }
        if (strncmp(lakon + 8 * (size_t)element, "C3D20RB", 7) ||
            ipkon[element] > nkon - 23) {
            bs_fail("only active expanded B32R elements are supported");
        }
        ++count;
    }
    if (!count || (bs.coupled && springs != 1)) {
        bs_fail("missing active B32R chain or native grounded spring");
    }
    bs_expect(stream, "REQUEST");
    bs_token(stream, token);
    if (strlen(token) != 32) {
        bs_fail("request identity must be 32 lowercase hexadecimal characters");
    }
    for (i = 0; i < 32; ++i) {
        if (!(token[i] >= '0' && token[i] <= '9') &&
            !(token[i] >= 'a' && token[i] <= 'f')) {
            bs_fail("request identity must be 32 lowercase hexadecimal characters");
        }
    }
    memcpy(bs.request, token, 33);
    bs_expect(stream, "END_TIME");
    bs_token(stream, token);
    errno = 0;
    bs.end_time = strtod(token, &tail);
    if (errno || *tail || !isfinite(bs.end_time) || bs.end_time <= 0.) {
        bs_fail("requires a finite positive requested end time");
    }
    bs_expect(stream, "UNITS");
    bs_expect(stream, "MM");
    bs_expect(stream, "N");
    bs_expect(stream, "NMM");
    for (;;) {
        bs_token(stream, token);
        if (!strcmp(token, "END")) {
            break;
        }
        if (bs.coupled && !strcmp(token, "SPRING")) {
            if (bs.spring_element) {
                bs_fail("repeated coupled spring declaration");
            }
            bs_owner(stream, bs.spring_owner);
            bs.spring_element = bs_integer(stream);
            bs.spring_node = bs_integer(stream);
            bs.spring_direction = bs_integer(stream);
            element = bs.spring_element - 1;
            if (element >= ne || ipkon[element] < 0 ||
                strncmp(lakon + 8 * (size_t)element, "ESPRNG10", 8) ||
                bs.spring_direction > 3 || bs.spring_node > nk ||
                kon[ipkon[element]] != bs.spring_node) {
                bs_fail("coupled SPRING1 declaration differs from the actual native element");
            }
            continue;
        }
        if (bs.coupled && !strcmp(token, "SOURCE")) {
            if (bs.source_node) {
                bs_fail("repeated coupled source declaration");
            }
            bs_owner(stream, bs.source_owner);
            bs.source_node = bs_integer(stream);
            continue;
        }
        if (bs.coupled && !strcmp(token, "SUPPORT")) {
            ITG directions, direction;
            if (bs.support_node) {
                bs_fail("repeated coupled physical support declaration");
            }
            bs_owner(stream, bs.support_owner);
            bs.support_node = bs_integer(stream);
            directions = bs_integer(stream);
            if (directions != 5) {
                bs_fail("coupled root requires five zero stabilizing degrees of freedom");
            }
            for (k = 0; k < directions; ++k) {
                direction = bs_integer(stream);
                if (direction > 6 || bs.support_directions[direction - 1]) {
                    bs_fail("invalid or repeated coupled root support direction");
                }
                bs.support_directions[direction - 1] = 1;
            }
            continue;
        }
        if (strcmp(token, "ELEMENT")) {
            bs_fail("expected an ELEMENT record or END");
        }
        element = bs_integer(stream);
        if (element > ne || ipkon[element - 1] < 0 || bs.elements[element - 1].declared ||
            strncmp(lakon + 8 * (size_t)(element - 1), "C3D20RB", 7)) {
            bs_fail("duplicate, inactive or unknown requested element");
        }
        index = ipkon[element - 1] + 20;
        for (k = 0; k < 3; ++k) {
            node = bs_integer(stream);
            if (node > nk || node != kon[index + k]) {
                bs_fail("requested B32R connectivity differs from the native expansion");
            }
            bs.elements[element - 1].nodes[k] = node;
        }
        if (bs.elements[element - 1].nodes[0] == bs.elements[element - 1].nodes[1] ||
            bs.elements[element - 1].nodes[0] == bs.elements[element - 1].nodes[2] ||
            bs.elements[element - 1].nodes[1] == bs.elements[element - 1].nodes[2]) {
            bs_fail("repeated nodes in requested beam");
        }
        bs.elements[element - 1].declared = 1;
        ++bs.count;
    }
    if (fscanf(stream, "%80s", token) != EOF || ferror(stream) || fclose(stream) ||
        bs.count != count) {
        bs_fail("request must declare the complete native B32R catalogue exactly once");
    }
    if (bs.coupled) {
        if (!bs.spring_element || !bs.source_node || !bs.support_node ||
            bs.support_directions[bs.spring_direction - 1] ||
            nload || nbody || ntie || prestress || thermal || iamboun ||
            nk > INT_MAX / 3 || nmpc < 0 || !materials ||
            !bs_early.input_seen || bs_early.input_mpcs != 0) {
            bs_fail("coupled domain requires one point source and zero prescribed supports");
        }
        for (element = 0; element < nmpc; ++element) {
            if (strncmp(labmpc + 20 * (size_t)element, "                    ", 20) &&
                strncmp(labmpc + 20 * (size_t)element, "MEANROT", 7)) {
                bs_fail("coupled beam domain does not support knots or user-defined couplings");
            }
        }
        bs.coordinates = bs_allocate(3 * (size_t)nk, sizeof(double));
        for (i = 0; i < 3 * (size_t)nk; ++i) {
            if (!isfinite(co[i])) {
                bs_fail("nonfinite native original coordinates");
            }
            bs.coordinates[i] = co[i];
        }
        bs_coupled_geometry(ipkon, kon, lakon, material_stride, materials);
        bs_coupled_supports(nboun, nodeboun, ndirboun, xboun, iamboun, typeboun);
    }
    bs.samples = bs_allocate(bs_product((size_t)ne, 2), sizeof(BSSample));
    if (atexit(bs_finish)) {
        bs_fail("cannot register final-frame validation");
    }
    bs.active = 1;
}

void bs_pointloads(ITG count, ITG* nodes, ITG* directions, double* values,
                   ITG nload, ITG nbody)
{
    ITG i, direction;
    if (!bs.active || !bs.coupled) {
        return;
    }
    if (nload || nbody || count < 1) {
        bs_fail("coupled beam accounting supports actual native point loads only");
    }
    memset(bs.pointload, 0, sizeof(bs.pointload));
    for (i = 0; i < count; ++i) {
        direction = directions[i];
        if (nodes[2 * (size_t)i] != bs.source_node || nodes[2 * (size_t)i + 1] ||
            direction < 1 || direction > 3 || !isfinite(values[i]) ||
            !isfinite(bs.pointload[direction - 1] + values[i])) {
            bs_fail("actual native point source differs from the declared free beam endpoint");
        }
        bs.pointload[direction - 1] += values[i];
    }
    bs.pointloads_seen = 1;
}

void bs_begin_actions(ITG iout, ITG step, ITG increment, double time, double* v)
{
    if (!bs.active || !bs.coupled) {
        return;
    }
    bs.actions_capturing = 0;
    if (iout != 1 && iout != 2) {
        return;
    }
    if (step != 1 || increment < 1 || !isfinite(time) || time <= 0. ||
        time > bs.end_time || !bs.pointloads_seen) {
        bs_fail("invalid retained native mechanical action frame");
    }
    memset(&bs.actions, 0, sizeof(bs.actions));
    memcpy(bs.actions.source, bs.pointload, sizeof(bs.pointload));
    bs_cross(bs.actions.source_moment,
             bs.coordinates + 3 * (size_t)(bs.source_node - 1), bs.actions.source);
    bs.action_step = step;
    bs.action_increment = increment;
    bs.action_time = time;
    bs.frame_displacements = v;
    bs.actions_capturing = 1;
}

/* This guard runs before native xn(idof)/a(:,idof) indexing. An unsupported
 * rotational DOF must be refused before the upstream three-entry access. */
void FORTRAN(bs_spring_law, (ITG* element, ITG* node, ITG* direction, ITG* kind,
                             ITG* tables, double* stiffness))
{
    if (!bs.active || !bs.coupled) {
        return;
    }
    if (*element != bs.spring_element || *node != bs.spring_node ||
        *direction < 1 || *direction > 3 || *direction != bs.spring_direction ||
        *kind != 2 || *tables != 1 || !isfinite(*stiffness) || *stiffness <= 0.) {
        bs_fail("native grounded spring requires the declared positive linear translational law");
    }
}

void FORTRAN(bs_spring, (ITG* element, ITG* node, ITG* direction, ITG* kind,
                         ITG* tables, double* stiffness, double* axis,
                         double* force, double* displacement))
{
    size_t k;
    if (!bs.active || !bs.coupled) {
        return;
    }
    if (*element != bs.spring_element || *node != bs.spring_node ||
        *direction != bs.spring_direction || *kind != 2 || *tables != 1 ||
        !isfinite(*stiffness) || *stiffness <= 0.) {
        bs_fail("native grounded spring requires the declared positive linear scalar law");
    }
    for (k = 0; k < 3; ++k) {
        if (!isfinite(axis[k]) || fabs(axis[k] - (k == (size_t)(*direction - 1))) > 1.e-12) {
            bs_fail("native grounded spring must follow its declared global translation axis");
        }
    }
    if (!bs.actions_capturing) {
        return;
    }
    if (bs.actions.spring_seen) {
        bs_fail("repeated grounded spring action in one retained native frame");
    }
    for (k = 0; k < 3; ++k) {
        if (!isfinite(force[k]) || !isfinite(displacement[k])) {
            bs_fail("nonfinite native grounded spring action or translation");
        }
        bs.actions.spring[k] = force[k];
        bs.actions.displacement[k] = displacement[k];
    }
    bs_cross(bs.actions.spring_moment,
             bs.coordinates + 3 * (size_t)(bs.spring_node - 1), bs.actions.spring);
    bs.actions.spring_seen = 1;
}

/* Called at the native resultsforc boundary after its existing MPC force
 * elimination and before its ordinary result restoration. The observer
 * neither projects a force vector nor modifies fn. The admitted point loads
 * must act only at free independent DOFs, so they have no contribution to
 * the native projected SPC residual. */
void bs_projected_supports(ITG nk, ITG mt, double* fn, ITG* nactdof)
{
    ITG node, direction, index, role, active;
    size_t a, k;
    BSSPC* spc;
    double force[3], moment[3], value;
    if (!bs.active || !bs.coupled || !bs.actions_capturing) {
        return;
    }
    if (bs.actions.support_seen || nk != bs.nk || mt < 4 || nk > INT_MAX / mt ||
        !bs.frame_displacements) {
        bs_fail("invalid or repeated native support output state");
    }
    for (direction = 1; direction <= 3; ++direction) {
        if (bs.pointload[direction - 1] != 0. &&
            nactdof[mt * (size_t)(bs.source_node - 1) + direction] <= 0) {
            bs_fail("coupled point loads require free independent native degrees of freedom");
        }
    }
    for (node = 1; node <= nk; ++node) {
        for (direction = 1; direction <= 3; ++direction) {
            index = mt * (node - 1) + direction;
            active = nactdof[index];
            if (active >= 0 || active % 2) {
                continue;
            }
            role = 0;
            a = bs_early.count;
            if (node == bs.support_node && bs.support_directions[direction - 1]) {
                role = 1;
            }
            else {
                for (a = 0; a < bs_early.count; ++a) {
                    if (node == bs_early.angles[a].auxiliary && direction <= 2) {
                        role = direction == 1 ? 2 : 3;
                        break;
                    }
                }
            }
            if (!role || bs.actions.spc_count == 9 || bs.frame_displacements[index] != 0. ||
                !isfinite(fn[index])) {
                bs_fail("unexpected native SPC identity, nonzero prescription or residual");
            }
            value = fn[index];
            spc = bs.actions.spcs + bs.actions.spc_count++;
            spc->node = node;
            spc->direction = direction;
            spc->original_direction = role == 1 ? direction : bs_early.angles[a].direction;
            spc->role = role;
            spc->value = value;
            memset(force, 0, sizeof(force));
            memset(moment, 0, sizeof(moment));
            if (role == 1) {
                force[direction - 1] = value;
                bs_cross(moment, bs.coordinates + 3 * (size_t)(node - 1), force);
            }
            else if (role == 2) {
                for (k = 0; k < 3; ++k) {
                    spc->axis[k] = bs_early.angles[a].axis[k];
                    moment[k] = value * spc->axis[k];
                }
            }
            /* The U-type homogeneous equation term is algebraic, not a
             * physical force or a second support couple. Retain its value
             * and identity, but do not add it to the structural wrench. */
            for (k = 0; k < 3; ++k) {
                bs.actions.support[k] += force[k];
                bs.actions.support_moment[k] += moment[k];
                if (!isfinite(bs.actions.support[k]) || !isfinite(bs.actions.support_moment[k])) {
                    bs_fail("native support wrench overflow");
                }
            }
        }
    }
    if (bs.actions.spc_count != 8) {
        bs_fail("native output must retain two translations and three angle/algebraic pairs");
    }
    bs.actions.support_seen = 1;
}

void bs_begin_results(ITG iout, ITG step, ITG increment, double time)
{
    if (!bs.active) {
        return;
    }
    bs.capturing = 0;
    bs.mapping = 0;
    /* Linear static writes its retained final result with iout=1;
     * nonlinear retained evaluations use iout=2. Actual FRD binding below
     * is required in either case; a computed map alone is not a frame. */
    if (iout != 1 && iout != 2) {
        return;
    }
    if (bs.pending || bs.current || step != 1 || increment < 1 ||
        !isfinite(time) || time <= 0. || time > bs.end_time) {
        bs_fail("invalid or unconsumed retained native result evaluation");
    }
    if (bs.coupled && (!bs.actions_capturing || !bs.actions.spring_seen ||
                       !bs.actions.support_seen || bs.action_step != step ||
                       bs.action_increment != increment || bs.action_time != time)) {
        bs_fail("native beam and physical-action observations do not share one retained frame");
    }
    bs.actions_capturing = 0;
    bs.frame_displacements = NULL;
    memset(bs.samples, 0, bs_product(bs_product((size_t)bs.ne, 2), sizeof(BSSample)));
    bs.step = step;
    bs.increment = increment;
    bs.time = time;
    bs.mapped = 0;
    bs.pending = 1;
    bs.capturing = 1;
}

void FORTRAN(bs_map_begin, ())
{
    if (!bs.active || !bs.capturing) {
        return;
    }
    if (bs.mapping || bs.mapped) {
        bs_fail("duplicate native stress-section map");
    }
    bs.mapping = 1;
}

ITG FORTRAN(bs_mapping_active, ())
{
    return bs.active && bs.mapping;
}

static double bs_dot(const double* first, const double* second)
{
    return first[0] * second[0] + first[1] * second[1] + first[2] * second[2];
}

void FORTRAN(bs_end_begin, (ITG* element, ITG* node, ITG* end,
                            double* position, double* e1, double* e2, double* normal))
{
    BSSample* sample;
    size_t k, slot;
    if (!bs.active || !bs.mapping) {
        return;
    }
    if (bs.current || *element < 1 || *element > bs.ne ||
        (*end != 1 && *end != 3) || !bs.elements[*element - 1].declared) {
        bs_fail("invalid native beam/end observation");
    }
    slot = 2 * (size_t)(*element - 1) + (*end == 3);
    sample = bs.samples + slot;
    if (sample->seen || *node != bs.elements[*element - 1].nodes[*end - 1]) {
        bs_fail("duplicate end or mismatched native beam node");
    }
    sample->element = *element;
    sample->node = *node;
    sample->end = *end;
    for (k = 0; k < 3; ++k) {
        if (!isfinite(position[k]) || !isfinite(e1[k]) ||
            !isfinite(e2[k]) || !isfinite(normal[k])) {
            bs_fail("nonfinite native section centroid or projection axis");
        }
        sample->position[k] = position[k];
        sample->e1[k] = e1[k];
        sample->e2[k] = e2[k];
        sample->normal[k] = normal[k];
    }
    if (fabs(bs_dot(e1, e1) - 1.) > 1.e-8 || fabs(bs_dot(e2, e2) - 1.) > 1.e-8 ||
        fabs(bs_dot(normal, normal) - 1.) > 1.e-8 || fabs(bs_dot(e1, e2)) > 1.e-8 ||
        fabs(bs_dot(e1, normal)) > 1.e-8 || fabs(bs_dot(e2, normal)) > 1.e-8) {
        bs_fail("native section axes are not finite orthonormal projection directions");
    }
    bs.current = sample;
}

void FORTRAN(bs_end_point, (double* force_increment, double* moment_increment))
{
    BSSample* sample = bs.current;
    size_t k;
    if (!bs.active || !bs.mapping) {
        return;
    }
    if (!sample || sample->points == INT_MAX) {
        bs_fail("native section point outside an active end observation");
    }
    for (k = 0; k < 3; ++k) {
        if (!isfinite(force_increment[k]) || !isfinite(moment_increment[k])) {
            bs_fail("nonfinite native section force or moment increment");
        }
        sample->force[k] += force_increment[k];
        sample->moment[k] += moment_increment[k];
        if (!isfinite(sample->force[k]) || !isfinite(sample->moment[k])) {
            bs_fail("native section integral overflow");
        }
    }
    ++sample->points;
}

void FORTRAN(bs_end_finish, ())
{
    BSSample* sample = bs.current;
    size_t k;
    if (!bs.active || !bs.mapping) {
        return;
    }
    if (!sample || sample->points < 1) {
        bs_fail("empty native section integration");
    }
    sample->channels[0] = bs_dot(sample->e1, sample->force);
    sample->channels[1] = bs_dot(sample->e2, sample->force);
    sample->channels[2] = bs_dot(sample->normal, sample->force);
    sample->channels[3] = bs_dot(sample->normal, sample->moment);
    sample->channels[4] = bs_dot(sample->e2, sample->moment);
    sample->channels[5] = bs_dot(sample->e1, sample->moment);
    for (k = 0; k < 6; ++k) {
        if (!isfinite(sample->channels[k])) {
            bs_fail("nonfinite native local resultant projection");
        }
    }
    sample->seen = 1;
    bs.current = NULL;
}

void FORTRAN(bs_map_end, ())
{
    ITG element;
    size_t count = 0;
    if (!bs.active || !bs.capturing) {
        return;
    }
    if (!bs.mapping || bs.current) {
        bs_fail("incomplete native stress-section map");
    }
    for (element = 0; element < bs.ne; ++element) {
        if (bs.elements[element].declared) {
            if (!bs.samples[2 * (size_t)element].seen ||
                !bs.samples[2 * (size_t)element + 1].seen) {
                bs_fail("missing native B32R end observation");
            }
            count += 2;
        }
    }
    if (count != 2 * bs.count) {
        bs_fail("native sample catalogue mismatch");
    }
    bs.mapping = 0;
    bs.mapped = 1;
    bs.capturing = 0;
}

static void bs_vector(FILE* stream, const double* value)
{
    fprintf(stream, "[%.17g,%.17g,%.17g]", value[0], value[1], value[2]);
}

static void bs_write_actions(FILE* stream, const BSActions* actions)
{
    double force[3], moment[3];
    size_t k, row;
    const char* roles[] = {"", "TRANSLATION", "ANGLE", "ALGEBRAIC"};
    fprintf(stream, ",\"native_actions\":{\"position_frame\":\"ORIGINAL_GLOBAL\","
            "\"moment_reference\":\"GLOBAL_ORIGIN\",\"force_action\":\"ON_STRUCTURAL_MODEL\","
            "\"source\":{\"owner\":\"%s\",\"node\":%d,\"position\":",
            bs.source_owner, bs.source_node);
    bs_vector(stream, bs.coordinates + 3 * (size_t)(bs.source_node - 1));
    fprintf(stream, ",\"force_global\":");
    bs_vector(stream, actions->source);
    fprintf(stream, ",\"moment_origin\":");
    bs_vector(stream, actions->source_moment);
    fprintf(stream, "},\"spring\":{\"owner\":\"%s\",\"element\":%d,\"node\":%d,\"position\":",
            bs.spring_owner, bs.spring_element, bs.spring_node);
    bs_vector(stream, bs.coordinates + 3 * (size_t)(bs.spring_node - 1));
    fprintf(stream, ",\"native_resisting_force\":");
    bs_vector(stream, actions->spring);
    for (k = 0; k < 3; ++k) {
        force[k] = -actions->spring[k];
        moment[k] = -actions->spring_moment[k];
    }
    fprintf(stream, ",\"force_global\":");
    bs_vector(stream, force);
    fprintf(stream, ",\"moment_origin\":");
    bs_vector(stream, moment);
    fprintf(stream, ",\"displacement\":");
    bs_vector(stream, actions->displacement);
    fprintf(stream, "},\"support\":{\"owner\":\"%s\",\"node\":%d,\"position\":",
            bs.support_owner, bs.support_node);
    bs_vector(stream, bs.coordinates + 3 * (size_t)(bs.support_node - 1));
    fprintf(stream, ",\"force_global\":");
    bs_vector(stream, actions->support);
    fprintf(stream, ",\"moment_origin\":");
    bs_vector(stream, actions->support_moment);
    fprintf(stream, ",\"spcs\":[");
    for (row = 0; row < actions->spc_count; ++row) {
        const BSSPC* spc = actions->spcs + row;
        fprintf(stream, "%s{\"node\":%d,\"direction\":%d,\"role\":\"%s\","
                "\"original_node\":%d,\"original_direction\":%d,\"value\":%.17g",
                row ? "," : "", spc->node, spc->direction, roles[spc->role],
                bs.support_node, spc->original_direction, spc->value);
        if (spc->role == 2) {
            fprintf(stream, ",\"axis\":");
            bs_vector(stream, spc->axis);
        }
        fprintf(stream, "}");
    }
    fprintf(stream, "]}}");
}

static void bs_write(void)
{
    char* output = bs_suffix(".out");
    char* temporary = bs_suffix(".out.tmp");
    FILE* stream = fopen(temporary, "wx");
    size_t frame, row;
    int bad;
    if (!stream) {
        bs_fail("cannot exclusively create native observer output");
    }
    fprintf(stream, "{\"schema\":\"CCX_BEAM_SECTION_V%d\",\"request\":\"%s\","
            "\"complete\":%s,\"units\":{\"length\":\"mm\",\"force\":\"N\",\"moment\":\"N*mm\"},"
            "\"position_frame\":\"CURRENT_EXPANDED_SECTION\","
            "\"basis_frame\":\"NATIVE_CURRENT_FACE_BASIS\","
            "\"sample_identity_scope\":\"ELEMENT_END_BEFORE_NODE_AVERAGING\","
            "\"moment_reference\":\"NATIVE_SECTION_CENTROID\","
            "\"force_action\":\"OUTWARD_NATIVE_ELEMENT_END_FACE\","
            "\"native_channels_method\":\"PROJECTED_NATIVE_FORCE_AND_MOMENT_INCREMENT_SUM\","
            "\"completion_requires_successful_child\":true,\"frames\":[",
            bs.coupled ? 2 : 1, bs.request,
            bs.frames[bs.frame_count - 1].time == bs.end_time ? "true" : "false");
    for (frame = 0; frame < bs.frame_count; ++frame) {
        BSFrame* item = bs.frames + frame;
        int first = 1;
        fprintf(stream, "%s{\"step\":%d,\"increment\":%d,\"frame\":%d,\"time\":%.17g,"
                "\"complete\":true,\"samples\":[", frame ? "," : "",
                item->step, item->increment, item->dataset, item->time);
        for (row = 0; row < 2 * (size_t)bs.ne; ++row) {
            BSSample* sample = item->samples + row;
            if (!sample->seen) {
                continue;
            }
            fprintf(stream, "%s{\"element\":%d,\"node\":%d,\"end\":%d,\"position\":",
                    first ? "" : ",", sample->element, sample->node, sample->end);
            first = 0;
            bs_vector(stream, sample->position);
            fprintf(stream, ",\"force_global\":");
            bs_vector(stream, sample->force);
            fprintf(stream, ",\"moment_global\":");
            bs_vector(stream, sample->moment);
            fprintf(stream, ",\"basis\":{\"e1\":");
            bs_vector(stream, sample->e1);
            fprintf(stream, ",\"e2\":");
            bs_vector(stream, sample->e2);
            fprintf(stream, ",\"normal\":");
            bs_vector(stream, sample->normal);
            fprintf(stream, "},\"native_channels\":{\"shear1\":%.17g,\"shear2\":%.17g,"
                    "\"axial\":%.17g,\"torque\":%.17g,\"bend2\":%.17g,\"bend1\":%.17g}}",
                    sample->channels[0], sample->channels[1], sample->channels[2],
                    sample->channels[3], sample->channels[4], sample->channels[5]);
        }
        fprintf(stream, "]");
        if (bs.coupled) {
            bs_write_actions(stream, &item->actions);
        }
        fprintf(stream, "}");
    }
    fprintf(stream, "]}\n");
    bad = ferror(stream);
    if (fclose(stream)) {
        bad = 1;
    }
    if (bad || rename(temporary, output)) {
        bs_fail("cannot atomically publish native observer output");
    }
    free(output);
    free(temporary);
}

void bs_frd_frame(ITG dataset, ITG step, ITG increment, double time)
{
    BSFrame* replacement;
    BSFrame* frame;
    if (!bs.active) {
        return;
    }
    if (!bs.pending || !bs.mapped || bs.mapping || bs.current || dataset < 1 ||
        step != bs.step || increment != bs.increment || time != bs.time) {
        bs_fail("FRD stress dataset differs from the observed native output evaluation");
    }
    if (bs.frame_count &&
        (dataset <= bs.frames[bs.frame_count - 1].dataset ||
         increment < bs.frames[bs.frame_count - 1].increment ||
         time < bs.frames[bs.frame_count - 1].time)) {
        bs_fail("nonmonotonic native FRD frame identity");
    }
    if (bs.frame_count == SIZE_MAX) {
        bs_fail("native frame count overflow");
    }
    replacement = realloc(bs.frames, bs_product(bs.frame_count + 1, sizeof(BSFrame)));
    if (!replacement) {
        bs_fail("native frame allocation failed");
    }
    bs.frames = replacement;
    frame = bs.frames + bs.frame_count++;
    frame->step = step;
    frame->increment = increment;
    frame->dataset = dataset;
    frame->time = time;
    frame->samples = bs_allocate(bs_product((size_t)bs.ne, 2), sizeof(BSSample));
    memcpy(frame->samples, bs.samples,
           bs_product(bs_product((size_t)bs.ne, 2), sizeof(BSSample)));
    frame->actions = bs.actions;
    bs.pending = 0;
    bs_write();
}
