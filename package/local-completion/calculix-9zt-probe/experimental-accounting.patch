+/* Experimental native probe, not an installed output contract. The load
+   vector is retained from the actual element RHS and point-load assembly,
+   not reconstructed from density, volume, or printed RF. */
+double *ccx9zt_loads=NULL;
+
+void ccx9zt_require_linear(ITG nmethod,ITG iperturb,ITG ithermal,
+                          ITG ntrans,ITG mcs,ITG ne,ITG *ipkon,char *lakon){
+  ITG i;
+  if(!getenv("CCX_9ZT_DIAGNOSTIC"))return;
+  if((nmethod!=1)||(iperturb>=2)||(ithermal>1)||(ntrans!=0)||(mcs!=0)){
+    fprintf(stderr,"9zt experimental probe: unsupported analysis; requires linear static mechanical global coordinates\n");
+    exit(201);
+  }
+  for(i=0;i<ne;i++){
+    if(ipkon[i]<0)continue;
+    if((strcmp1(&lakon[8*i],"C3D4    ")!=0)&&
+       (strcmp1(&lakon[8*i],"C3D10   ")!=0)){
+      fprintf(stderr,"9zt experimental probe: unsupported element; only C3D4/C3D10 benchmarked\n");
+      exit(201);
+    }
+  }
+}
+
+ITG FORTRAN(ccx9zt_collect,()){
+  return ccx9zt_loads!=NULL;
+}
+
+void ccx9zt_record(double *fn,ITG *nk,ITG *mi,ITG *nactdof,
+                  ITG *ipompc,ITG *nodempc,double *coefmpc,ITG *nmpc){
+  ITG mt=mi[1]+1,i,j,index,ist,node,dir;
+  double *internal=NULL,*external=NULL,fi,fe;
+  FILE *out=fopen(getenv("CCX_9ZT_DIAGNOSTIC"),"w");
+  if(!out){perror("9zt diagnostic");exit(201);}
+  NNEW(internal,double,mt**nk);
+  NNEW(external,double,mt**nk);
+  memcpy(internal,fn,sizeof(double)*mt**nk);
+  memcpy(external,ccx9zt_loads,sizeof(double)*mt**nk);
+  /* Use the solver's already decascaded MPC coefficients for both vectors.
+     Do not re-add dependent forces: these are generalized residuals. */
+  for(i=0;i<*nmpc;i++){
+    ist=ipompc[i]-1;
+    node=nodempc[3*ist]-1;dir=nodempc[3*ist+1];
+    if(dir>3)continue;
+    fi=internal[mt*node+dir]/coefmpc[ist];
+    fe=external[mt*node+dir]/coefmpc[ist];
+    internal[mt*node+dir]=0.;external[mt*node+dir]=0.;
+    index=nodempc[3*ist+2]-1;
+    while(index>=0){
+      node=nodempc[3*index]-1;dir=nodempc[3*index+1];
+      internal[mt*node+dir]-=coefmpc[index]*fi;
+      external[mt*node+dir]-=coefmpc[index]*fe;
+      index=nodempc[3*index+2]-1;
+    }
+  }
+  fprintf(out,"CCX9ZT_DIAGNOSTIC_V0 node dof internal external residual\n");
+  for(i=0;i<*nk;i++)for(j=1;j<=3;j++){
+    index=mt*i+j;
+    if((nactdof[index]<0)&&(nactdof[index]%2==0))
+      fprintf(out,"%d %d %.17g %.17g %.17g\n",(int)i+1,(int)j,
+              internal[index],external[index],internal[index]-external[index]);
+  }
+  SFREE(internal);SFREE(external);
+  if(fclose(out)){perror("9zt diagnostic close");exit(201);}
+}
