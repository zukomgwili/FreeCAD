"""Publicly authored analytical beam/solid/contact meshes with real CAD owners.

The FemMesh is constructed here, not generated by Gmsh. Its native entity
groups bind the known Tet/beam connectivity to the actual compound geometry.
Coincident contact faces remain distinct material owners and distinct nodes.
No input deck is edited, no force/stress is recovered, and no mesher is run.
"""

from collections import Counter
from types import SimpleNamespace

import FreeCAD as App
import Fem
import ObjectsFem
import Part

from femmesh import meshtools
from femtest.app.beam_coupling_fixtures import make_hybrid_series


def _end_face(solid, x):
    return next(
        "Face" + str(index)
        for index, face in enumerate(solid.Shape.Faces, 1)
        if all(abs(vertex.Point.x - x) < 1e-10 for vertex in face.Vertexes)
    )


def _compound_entity(compound, owner, name):
    proxy = SimpleNamespace(Name="AnalyticalMeshEntity", References=[(owner, [name])])
    names = meshtools.get_reference_group_elements(proxy, compound)[1]
    if len(names) != 1:
        raise ValueError("Analytical mesh entity has no unique compound CAD owner")
    return names[0]


def _owner_groups(model, backing, native, boundary, owner_elements):
    """Author native groups from constructed connectivity and real CAD incidence."""
    compound = model.doc.HybridGeometry
    groups = {}

    def add(owner, entity, kind, members):
        name = _compound_entity(compound, owner, entity)
        if name in groups or not members:
            raise ValueError("Analytical mesh has repeated or empty CAD entity membership")
        group = native.addGroup(name, kind)
        native.addGroupElements(group, sorted(members))
        groups[name] = group

    for owner in (model.solid, backing):
        add(owner, "Solid1", "Volume", owner_elements[owner.Name])
        owned_boundary = boundary[owner.Name]
        for index, face in enumerate(owner.Shape.Faces, 1):
            members = [
                element
                for element, nodes in owned_boundary.items()
                if all(
                    face.distToShape(Part.Vertex(native.Nodes[node]))[0] <= 1e-10 for node in nodes
                )
            ]
            add(owner, "Face" + str(index), "Face", members)
    add(model.geometry, "Edge1", "Edge", model.beam_elements)
    add(model.geometry, "Vertex1", "Node", (model.beam_nodes[0],))
    add(model.geometry, "Vertex2", "Node", (model.beam_nodes[-1],))
    model.mesh.FemMesh = native
    names = list(groups)
    model.mesh.ElementGroupNames = names
    model.mesh.ElementGroupReferences = [(compound, names)]
    model.mesh.ElementGroupGeometry = meshtools.get_mesh_geometry_signature(compound)


def make_contact_series(doc, friction=False, source="force"):
    """Create the frozen guided two-prism series using ordinary native objects.

    The triangle area is 75 mm² and both prism lengths are 20 mm. With
    E=200000 MPa, nu=0, Kcontact=100000 MPa/mm, Kspring=10000 N/mm and
    -100 N X tip force, the affine references are p=4/3 MPa, clearance
    -1/75000 mm, RBE Ux=-7/25000 mm and beam-root Ux=-257/25000 mm.
    The force-controlled case has a real five-DOF zero guide on the loaded
    solid RBE as well as the original beam guide. The alternate opening
    source replaces the Force with a +0.002 mm tip-X displacement; it is
    not an unsupported open body carrying a nonzero dead load.
    """
    if source not in ("force", "opening"):
        raise ValueError("Choose the force or prescribed-opening analytical source")
    model = make_hybrid_series(doc)
    yz = ((12.0, -28.0), (22.0, -28.0), (17.0, -13.0))
    points = [App.Vector(-50.0, y, z) for y, z in yz]
    backing = doc.addObject("Part::Feature", "ContactBacking")
    backing.Shape = Part.Face(Part.makePolygon(points + [points[0]])).extrude(App.Vector(20, 0, 0))
    doc.HybridGeometry.Links = [model.geometry, model.solid, backing]
    doc.recompute()
    model.fixed.References = [(backing, [_end_face(backing, -50.0)])]
    model.force.Reversed = True
    for axis in "YZ":
        setattr(model.rbe, "TranslationalMode" + axis, "Constraint")
    for axis in "XYZ":
        setattr(model.rbe, "RotationalMode" + axis, "Constraint")
    model.rbe.Displacement = App.Vector()
    model.rbe.Rotation = App.Rotation()

    old = model.mesh.FemMesh
    native = Fem.FemMesh()
    for node, point in old.Nodes.items():
        native.addNode(point.x, point.y, point.z, node)
    for element in model.beam_elements:
        native.addEdge(list(old.getElementNodes(element)), element)
    loaded_tets = [tuple(old.getElementNodes(element)) for element in model.solid_elements]
    for element, nodes in zip(model.solid_elements, loaded_tets):
        native.addVolume(list(nodes), element)
    backing_far = (301, 302, 303)
    backing_interface = (304, 305, 306)
    for node, (y, z) in zip(backing_far, yz):
        native.addNode(-50.0, y, z, node)
    for node, (y, z) in zip(backing_interface, yz):
        native.addNode(-30.0, y, z, node)
    backing_elements = (301, 302, 303)
    backing_tets = (
        (302, 301, 303, 304),
        (303, 302, 304, 305),
        (304, 303, 305, 306),
    )
    # These are native SMESH orders; public writeABAQUS emits positive Tet4s
    # after its documented permutation, just as in the existing sv7 fixture.
    for element, nodes in zip(backing_elements, backing_tets):
        native.addVolume(list(nodes), element)
    boundary = {}
    next_face = 501
    for owner, tetrahedra in ((model.solid, loaded_tets), (backing, backing_tets)):
        facets = [
            (nodes[a], nodes[b], nodes[c])
            for nodes in tetrahedra
            for a, b, c in ((0, 2, 1), (0, 1, 3), (1, 2, 3), (0, 3, 2))
        ]
        counts = Counter(tuple(sorted(face)) for face in facets)
        owned = {}
        for nodes in facets:
            if counts[tuple(sorted(nodes))] == 1:
                native.addFace(list(nodes), next_face)
                owned[next_face] = nodes
                next_face += 1
        boundary[owner.Name] = owned
    model.mesh.Label = "Manually authored analytical contact mesh"
    _owner_groups(
        model,
        backing,
        native,
        boundary,
        {model.solid.Name: model.solid_elements, backing.Name: backing_elements},
    )
    contact = ObjectsFem.makeConstraintContact(doc, "BeamSolidContact")
    contact.SurfaceBehavior = "Linear"
    contact.Slope = "100000 MPa/mm"
    contact.Friction = friction
    contact.FrictionCoefficient = 0.3
    contact.StickSlope = "10000 MPa/mm"
    contact.Adjust = "0 mm"
    # Native ownership order is slave first, master last, irrespective of
    # physical loading direction; both are genuine Tet boundary faces.
    contact.References = [
        (model.solid, [_end_face(model.solid, -30.0)]),
        (backing, [_end_face(backing, -30.0)]),
    ]
    model.analysis.addObject(contact)
    model.solver.NativeContactOutputs = [contact]
    model.backing = backing
    model.contact = contact
    model.backing_nodes = backing_far + backing_interface
    model.backing_elements = backing_elements
    model.backing_far_nodes = backing_far
    model.backing_interface_nodes = backing_interface
    model.loaded_interface_nodes = model.far_nodes
    model.all_solid_nodes = model.solid_nodes + model.backing_nodes
    model.all_solid_elements = model.solid_elements + model.backing_elements
    model.source_kind = source
    model.source = model.force
    model.opening = None
    if source == "opening":
        doc.removeObject(model.force.Name)
        model.force = None
        opening = ObjectsFem.makeConstraintDisplacement(doc, "BeamTipOpening")
        opening.References = [(model.geometry, ["Vertex2"])]
        opening.xFree = False
        opening.xDisplacement = "0.002 mm"
        opening.yFree = opening.zFree = True
        opening.rotxFree = opening.rotyFree = opening.rotzFree = True
        model.analysis.addObject(opening)
        model.source = model.opening = opening
    doc.recompute()
    return model
