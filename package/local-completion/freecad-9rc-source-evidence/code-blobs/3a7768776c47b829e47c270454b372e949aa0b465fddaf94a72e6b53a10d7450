static void bs_fail(const char* message)
{
    fprintf(stderr, "*ERROR CCX beam section V%d: %s\n", bs.coupled + 1, message);
    fflush(stderr);
    exit(201);
}

static int bs_early_enabled(void)
{
    const char* path;
    FILE* stream;
    char schema[81];
    if (!bs_early.checked) {
        bs_early.checked = 1;
        path = getenv("CCX_BEAM_SECTION_REQUEST");
        stream = path && *path ? fopen(path, "r") : NULL;
        if (stream) {
            if (fscanf(stream, "%80s", schema) == 1) {
                bs_early.enabled = !strcmp(schema, "CCX_BEAM_SECTION_V2") ? 2 :
                                   !strcmp(schema, "CCX_BEAM_SECTION_V3") ? 3 :
                                   !strcmp(schema, "CCX_BEAM_SECTION_V4") ? 4 : 0;
            }
            fclose(stream);
        }
    }
    return bs_early.enabled;
}

void FORTRAN(bs_input_mpcs, (ITG* count))
{
    if (!bs_early_enabled()) {
        return;
    }
    if (bs_early.input_seen) {
        bs_fail("coupled beam observation supports one native mesh generation only");
    }
    bs_early.input_seen = 1;
    bs_early.input_mpcs = *count;
}

/* gen3dboun runs before the final expanded mesh and bs_prepare exist.
 * Retain only the native identities and axis values generated by its actual
 * mean-rotation branch. No solver array pointer survives reallocation. */
void FORTRAN(bs_record_angle, (ITG* original, ITG* direction, ITG* auxiliary, double* axis))
{
    size_t k;
    BSAngle* angle;
    if (!bs_early_enabled()) {
        return;
    }
    if (bs_early.count == 3) {
        bs_fail("coupled beam domain permits one endpoint with at most three rotations");
    }
    angle = bs_early.angles + bs_early.count++;
    angle->original = *original;
    angle->direction = *direction + 3;
    angle->auxiliary = *auxiliary;
    for (k = 0; k < 3; ++k) {
        angle->axis[k] = axis[k];
    }
}

static size_t bs_product(size_t left, size_t right)
{
    if (right && left > SIZE_MAX / right) {
        bs_fail("allocation dimension overflow");
    }
    return left * right;
}

static void* bs_allocate(size_t count, size_t size)
{
    void* result;
    bs_product(count, size);
    result = calloc(count ? count : 1, size);
    if (!result) {
        bs_fail("allocation failed");
    }
    return result;
}

void FORTRAN(bs_record_rigid, (ITG* receiver, ITG* reference, ITG* rotation,
                               ITG* auxiliary, ITG* row, ITG* direction))
{
    BSRigid* records;
    size_t capacity;
    if (bs_early_enabled() < 3) {
        return;
    }
    if (bs_early.rigid_count == bs_early.rigid_capacity) {
        capacity = bs_early.rigid_capacity ? bs_product(bs_early.rigid_capacity, 2) : 16;
        records = realloc(bs_early.rigids, bs_product(capacity, sizeof(BSRigid)));
        if (!records) {
            bs_fail("cannot retain native rigid-body graph identities");
        }
        bs_early.rigids = records;
        bs_early.rigid_capacity = capacity;
    }
    bs_early.rigids[bs_early.rigid_count++] =
        (BSRigid){*receiver, *reference, *rotation, *auxiliary, *row, *direction};
}

static void bs_token(FILE* stream, char token[81])
{
    if (fscanf(stream, "%80s", token) != 1) {
        bs_fail("truncated request");
    }
}

static void bs_expect(FILE* stream, const char* wanted)
{
    char token[81];
    bs_token(stream, token);
    if (strcmp(token, wanted)) {
        bs_fail("unexpected request token");
    }
}

static ITG bs_integer(FILE* stream)
{
    char token[81];
    const unsigned char* p;
    unsigned long value = 0;
    bs_token(stream, token);
    if (*token < '1' || *token > '9') {
        bs_fail("node and element labels require canonical positive integers");
    }
    for (p = (const unsigned char*)token; *p; ++p) {
        if (*p < '0' || *p > '9' ||
            value > ((unsigned long)INT_MAX - (unsigned long)(*p - '0')) / 10) {
            bs_fail("node or element label overflow");
        }
        value = 10 * value + (unsigned long)(*p - '0');
    }
    return (ITG)value;
}

static char* bs_suffix(const char* suffix)
{
    size_t path_length = strlen(bs.path), suffix_length = strlen(suffix);
    char* result;
    if (path_length > SIZE_MAX - suffix_length - 1) {
        bs_fail("output path overflow");
    }
    result = bs_allocate(path_length + suffix_length + 1, 1);
    memcpy(result, bs.path, path_length);
    memcpy(result + path_length, suffix, suffix_length + 1);
    return result;
}

static void bs_absent(const char* path)
{
    struct stat info;
    errno = 0;
    if (!lstat(path, &info) || errno != ENOENT) {
        bs_fail("output and temporary paths must be fresh for this child");
    }
}

static void bs_finish(void)
{
    if (bs.active && (!bs.frame_count || bs.pending ||
                      bs.frames[bs.frame_count - 1].time != bs.end_time)) {
        fprintf(stderr, "*ERROR CCX beam section V%d: missing complete final native frame\n",
                bs.coupled + 1);
        fflush(NULL);
        _Exit(201);
    }
}

static void bs_owner(FILE* stream, char owner[81])
{
    const unsigned char* p;
    bs_token(stream, owner);
    for (p = (const unsigned char*)owner; *p; ++p) {
        if (!((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') ||
              (*p >= '0' && *p <= '9') || *p == '_')) {
            bs_fail("coupled owner must be an unambiguous native identifier");
        }
    }
}

static ITG* bs_node_list(FILE* stream, size_t* count)
{
    ITG* result;
    unsigned char* seen;
    size_t i;
    ITG node;
    *count = (size_t)bs_integer(stream);
    if (*count > (size_t)bs.nk) {
        bs_fail("native mixed node list exceeds the actual mesh");
    }
    result = bs_allocate(*count, sizeof(ITG));
    seen = bs_allocate((size_t)bs.nk, 1);
    for (i = 0; i < *count; ++i) {
        node = bs_integer(stream);
        if (node > bs.nk || seen[node - 1]) {
            bs_fail("mixed node list has an unknown or repeated identity");
        }
        result[i] = node;
        seen[node - 1] = 1;
    }
    free(seen);
    return result;
}

static void bs_cross(double* result, const double* position, const double* force)
{
    result[0] = position[1] * force[2] - position[2] * force[1];
    result[1] = position[2] * force[0] - position[0] * force[2];
    result[2] = position[0] * force[1] - position[1] * force[0];
    if (!isfinite(result[0]) || !isfinite(result[1]) || !isfinite(result[2])) {
        bs_fail("nonfinite native origin-moment transport");
    }
}

static int bs_same_name(const char* left, const char* right)
{
    while (*left && *right) {
        if (toupper((unsigned char)*left++) != toupper((unsigned char)*right++)) {
            return 0;
        }
    }
    return *left == *right;
}

static int bs_solid_owner_id(const char* name)
{
    return !strcmp(name, bs.solid_owner) ? 1 :
           !strcmp(name, bs.second_solid_owner) ? 2 : 0;
}

static void bs_sort_nodes(ITG nodes[3])
{
    ITG i, j, value;
    for (i = 0; i < 3; ++i) {
        for (j = i + 1; j < 3; ++j) {
            if (nodes[j] < nodes[i]) {
                value = nodes[i]; nodes[i] = nodes[j]; nodes[j] = value;
            }
        }
    }
}

static int bs_contact_face_order(const void* left, const void* right)
{
    const BSContactFace *a = left, *b = right;
    size_t i;
    if (a->side != b->side) {
        return a->side - b->side;
    }
    for (i = 0; i < 3; ++i) {
        if (a->nodes[i] != b->nodes[i]) {
            return (a->nodes[i] > b->nodes[i]) - (a->nodes[i] < b->nodes[i]);
        }
    }
    return 0;
}

typedef struct
{
    double start, end;
    ITG first, last;
} BSInterval;

static int bs_interval_order(const void* left, const void* right)
{
    const BSInterval *a = left, *b = right;
    return (a->start > b->start) - (a->start < b->start);
}

static void bs_coupled_geometry(ITG* ipkon, ITG* kon, char* lakon,
                                ITG material_stride, ITG* materials)
{
    /* Matching native section corners, not oriented outward-face order. */
    static const int corners[3][4] = {{0, 4, 7, 3}, {8, 12, 14, 10}, {1, 5, 6, 2}};
    BSInterval* intervals = bs_allocate(bs.count, sizeof(BSInterval));
    ITG *roles = bs_allocate((size_t)bs.nk, sizeof(ITG));
    ITG element, k, side, corner, node, material = 0;
    size_t row = 0;
    double direction[3], length2 = 0., root[3], reference[2][3] = {{0.}};
    double point[3], projection[3], s[3], centroid[3], edges[2][3];
    double tolerance, length, error, norm, dot;
    if (bs.spring_node != bs.support_node || bs.source_node == bs.support_node ||
        bs.spring_node > bs.nk || bs.source_node > bs.nk || material_stride < 1) {
        bs_fail("coupled source and grounded support must be distinct original beam endpoints");
    }
    for (k = 0; k < 3; ++k) {
        root[k] = bs.coordinates[3 * (size_t)(bs.support_node - 1) + k];
        direction[k] = bs.coordinates[3 * (size_t)(bs.source_node - 1) + k] - root[k];
        length2 += direction[k] * direction[k];
    }
    if (!isfinite(length2) || length2 <= 0.) {
        bs_fail("coupled beam chain has no finite positive length");
    }
    length = sqrt(length2);
    tolerance = 1.e-8 * fmax(1., length);
    for (k = 0; k < 3; ++k) {
        if (k != bs.spring_direction - 1 && fabs(direction[k]) > tolerance) {
            bs_fail("coupled chain must follow its scalar global spring axis");
        }
    }
    for (element = 0; element < bs.ne; ++element) {
        BSElement* beam = bs.elements + element;
        if (!beam->declared) {
            continue;
        }
        if (lakon[8 * (size_t)element + 7] != 'R') {
            bs_fail("coupled beam diagnostics require native rectangular sections");
        }
        if (!material) {
            material = materials[(size_t)material_stride * element];
        }
        if (material < 1 || materials[(size_t)material_stride * element] != material) {
            bs_fail("coupled beam chain requires one native material assignment");
        }
        for (side = 0; side < 3; ++side) {
            node = beam->nodes[side];
            if (roles[node - 1] == 2 || (side == 1 && roles[node - 1])) {
                bs_fail("coupled chain has a reused midside or endpoint identity");
            }
            roles[node - 1] = side == 1 ? 2 : 1;
            s[side] = 0.;
            for (k = 0; k < 3; ++k) {
                point[k] = bs.coordinates[3 * (size_t)(node - 1) + k] - root[k];
                s[side] += point[k] * direction[k] / length2;
            }
            error = 0.;
            for (k = 0; k < 3; ++k) {
                projection[k] = point[k] - s[side] * direction[k];
                error += projection[k] * projection[k];
            }
            if (!isfinite(s[side]) || !isfinite(error) || error > tolerance * tolerance ||
                s[side] < -1.e-8 || s[side] > 1. + 1.e-8) {
                bs_fail("coupled original beam nodes are not one straight collinear chain");
            }
        }
        if (s[2] <= s[0] || fabs(s[1] - 0.5 * (s[0] + s[2])) > 1.e-8) {
            bs_fail("coupled segments require the source direction and centered midsides");
        }
        intervals[row] = (BSInterval){s[0], s[2], beam->nodes[0], beam->nodes[2]};
        for (side = 0; side < 3; ++side) {
            memset(centroid, 0, sizeof(centroid));
            for (corner = 0; corner < 4; ++corner) {
                node = kon[(size_t)ipkon[element] + corners[side][corner]];
                if (node < 1 || node > bs.nk) {
                    bs_fail("expanded native section node is outside the mesh");
                }
                for (k = 0; k < 3; ++k) {
                    centroid[k] += bs.coordinates[3 * (size_t)(node - 1) + k] / 4.;
                }
            }
            for (k = 0; k < 3; ++k) {
                if (fabs(centroid[k] - bs.coordinates[
                        3 * (size_t)(beam->nodes[side] - 1) + k]) > tolerance) {
                    bs_fail("coupled beam sections must have zero native offsets");
                }
                node = kon[(size_t)ipkon[element] + corners[side][0]];
                edges[0][k] = bs.coordinates[3 * (size_t)(kon[(size_t)ipkon[element] +
                                     corners[side][1]] - 1) + k] -
                              bs.coordinates[3 * (size_t)(node - 1) + k];
                edges[1][k] = bs.coordinates[3 * (size_t)(kon[(size_t)ipkon[element] +
                                     corners[side][3]] - 1) + k] -
                              bs.coordinates[3 * (size_t)(node - 1) + k];
                if (!row && !side) {
                    reference[0][k] = edges[0][k];
                    reference[1][k] = edges[1][k];
                }
                if (fabs(edges[0][k] - reference[0][k]) > tolerance ||
                    fabs(edges[1][k] - reference[1][k]) > tolerance) {
                    bs_fail("coupled native rectangular sections must be uniform and aligned");
                }
            }
            dot = norm = 0.;
            for (k = 0; k < 3; ++k) {
                dot += edges[0][k] * edges[1][k];
                norm += edges[0][k] * edges[0][k];
            }
            if (!isfinite(dot) || !isfinite(norm) || norm <= 0. ||
                fabs(dot) > tolerance * fmax(1., sqrt(norm))) {
                bs_fail("invalid coupled rectangular section geometry");
            }
        }
        ++row;
    }
    qsort(intervals, bs.count, sizeof(BSInterval), bs_interval_order);
    if (intervals[0].first != bs.support_node ||
        intervals[bs.count - 1].last != bs.source_node) {
        bs_fail("coupled source and support must be the chain endpoints");
    }
    for (row = 1; row < bs.count; ++row) {
        if (intervals[row].first != intervals[row - 1].last ||
            fabs(intervals[row].start - intervals[row - 1].end) > 1.e-8) {
            bs_fail("coupled beam catalogue is disconnected, overlapping or branched");
        }
    }
    free(intervals);
    free(roles);
}

typedef struct
{
    ITG nodes[3], element, face;
} BSTetFace;

static int bs_face_order(const void* left, const void* right)
{
    const BSTetFace *a = left, *b = right;
    size_t k;
    for (k = 0; k < 3; ++k) {
        if (a->nodes[k] != b->nodes[k]) {
            return (a->nodes[k] > b->nodes[k]) - (a->nodes[k] < b->nodes[k]);
        }
    }
    return 0;
}

static ITG bs_component(ITG* parents, ITG element)
{
    ITG root = element, next;
    while (parents[root] != root) {
        root = parents[root];
    }
    while (element != root) {
        next = parents[element];
        parents[element] = root;
        element = next;
    }
    return root;
}

static void bs_mixed_geometry(ITG* ipkon, ITG* kon)
{
    static const int faces[4][3] = {{0, 2, 1}, {0, 1, 3}, {1, 2, 3}, {0, 3, 2}};
    BSTetFace* catalogue = bs_allocate(bs_product(bs.solid_count, 4), sizeof(BSTetFace));
    ITG* parents = bs_allocate((size_t)bs.ne, sizeof(ITG));
    ITG* contact_index = bs_allocate(bs_product((size_t)bs.ne, 4), sizeof(ITG));
    ITG element, node, i, j, k, temporary, components[2] = {-1, -1}, owner;
    int fixed_owner = 0, port_owner = 0;
    size_t face_count = 0, first, last, r;
    double origin[3], direction[3], vector[3], cross[3], scale = 0., length, maximum = 0.;
    if (!bs.receiver_count || bs.receiver_count < 3 || !bs.fixed_count ||
        bs.reference_node < 1 || bs.reference_node > bs.nk ||
        bs.rotation_node < 1 || bs.rotation_node > bs.nk ||
        bs.reference_node == bs.rotation_node || !bs.solid_count) {
        bs_fail("mixed domain requires a real solid, physical support and finite rigid port");
    }
    for (r = 0; r < bs.contact_face_count; ++r) {
        BSContactFace* face = bs.contact_faces + r;
        size_t slot = 4 * (size_t)(face->element - 1) + face->face - 1;
        if (contact_index[slot]) {
            bs_fail("repeated native contact face declaration");
        }
        contact_index[slot] = (ITG)r + 1;
    }
    bs.beam_nodes = bs_allocate((size_t)bs.nk, 1);
    bs.fixed_index = bs_allocate((size_t)bs.nk, sizeof(ITG));
    for (element = 0; element < bs.ne; ++element) {
        if (bs.elements[element].declared) {
            for (i = 0; i < 23; ++i) {
                node = kon[(size_t)ipkon[element] + i];
                if (node < 1 || node > bs.nk || bs.solid_nodes[node - 1]) {
                    bs_fail("beam and solid structural node identities must be disjoint");
                }
                bs.beam_nodes[node - 1] = 1;
            }
        }
        if (!bs.solids[element].declared) {
            continue;
        }
        parents[element] = element;
        for (i = 0; i < 4; ++i) {
            BSTetFace* face = catalogue + face_count++;
            face->element = element;
            face->face = i + 1;
            for (j = 0; j < 3; ++j) {
                face->nodes[j] = bs.solids[element].nodes[faces[i][j]];
            }
            for (j = 0; j < 3; ++j) {
                for (k = j + 1; k < 3; ++k) {
                    if (face->nodes[k] < face->nodes[j]) {
                        temporary = face->nodes[j];
                        face->nodes[j] = face->nodes[k];
                        face->nodes[k] = temporary;
                    }
                }
            }
        }
    }
    qsort(catalogue, face_count, sizeof(BSTetFace), bs_face_order);
    for (first = 0; first < face_count; first = last) {
        last = first + 1;
        while (last < face_count && !bs_face_order(catalogue + first, catalogue + last)) {
            ++last;
        }
        if (last - first > 2) {
            bs_fail("mixed tetrahedral body has a non-manifold native face");
        }
        if (last - first == 2) {
            if (bs.solids[catalogue[first].element].owner !=
                bs.solids[catalogue[first + 1].element].owner) {
                bs_fail("two contact body owners must not share a structural face");
            }
            parents[bs_component(parents, catalogue[first].element)] =
                bs_component(parents, catalogue[first + 1].element);
        }
        else {
            BSTetFace* face = catalogue + first;
            ITG declared = contact_index[4 * (size_t)face->element + face->face - 1];
            if (declared) {
                bs.contact_faces[declared - 1].exterior = 1;
            }
        }
    }
    for (element = 0; element < bs.ne; ++element) {
        if (!bs.solids[element].declared) {
            continue;
        }
        owner = bs.solids[element].owner - 1;
        if (owner < 0 || owner >= bs.solid_owner_count) {
            bs_fail("tetrahedron has no declared physical owner");
        }
        if (components[owner] < 0) {
            components[owner] = bs_component(parents, element);
        }
        if (bs_component(parents, element) != components[owner]) {
            bs_fail("each mixed tetrahedral owner must be one face-connected physical body");
        }
    }
    for (r = 0; r < bs.fixed_count; ++r) {
        node = bs.fixed_nodes[r];
        if (!bs.solid_nodes[node - 1] || bs.beam_nodes[node - 1]) {
            bs_fail("physical solid supports require true tetrahedral structural nodes");
        }
        if (!fixed_owner) {
            fixed_owner = bs.solid_nodes[node - 1];
        }
        if (bs.solid_nodes[node - 1] != fixed_owner) {
            bs_fail("physical solid support must belong to one body owner");
        }
        bs.fixed_index[node - 1] = (ITG)r + 1;
    }
    for (r = 0; r < bs.receiver_count; ++r) {
        node = bs.receivers[r];
        if (!bs.solid_nodes[node - 1] || bs.fixed_index[node - 1] ||
            bs.beam_nodes[node - 1]) {
            bs_fail("rigid receivers must be solid-only nodes disjoint from physical supports");
        }
        if (!port_owner) {
            port_owner = bs.solid_nodes[node - 1];
        }
        if (bs.solid_nodes[node - 1] != port_owner) {
            bs_fail("rigid receiving region must belong to one physical body");
        }
    }
    if (bs.coupled == 3 && (bs.solid_owner_count != 2 || fixed_owner == port_owner ||
                           components[0] < 0 || components[1] < 0)) {
        bs_fail("contact requires two separate genuine bodies joined by their declared interface");
    }
    if (bs.solid_nodes[bs.reference_node - 1] || bs.beam_nodes[bs.reference_node - 1] ||
        bs.solid_nodes[bs.rotation_node - 1] || bs.beam_nodes[bs.rotation_node - 1]) {
        bs_fail("native rigid reference and rotation ports must be detached structural identities");
    }
    memcpy(origin, bs.coordinates + 3 * (size_t)(bs.receivers[0] - 1), sizeof(origin));
    memset(direction, 0, sizeof(direction));
    for (r = 1; r < bs.receiver_count; ++r) {
        length = 0.;
        for (i = 0; i < 3; ++i) {
            vector[i] = bs.coordinates[3 * (size_t)(bs.receivers[r] - 1) + i] - origin[i];
            length += vector[i] * vector[i];
        }
        if (length > scale) {
            scale = length;
            memcpy(direction, vector, sizeof(direction));
        }
    }
    for (r = 1; r < bs.receiver_count; ++r) {
        for (i = 0; i < 3; ++i) {
            vector[i] = bs.coordinates[3 * (size_t)(bs.receivers[r] - 1) + i] - origin[i];
        }
        bs_cross(cross, direction, vector);
        length = cross[0] * cross[0] + cross[1] * cross[1] + cross[2] * cross[2];
        maximum = fmax(maximum, length);
    }
    if (!isfinite(scale) || !isfinite(maximum) || scale <= 0. ||
        maximum <= 1.e-20 * scale * scale) {
        bs_fail("native rigid receiving region requires three non-collinear solid nodes");
    }
    for (i = 0; i < 3; ++i) {
        if (i != bs.spring_direction - 1 &&
            fabs(bs.coordinates[3 * (size_t)(bs.reference_node - 1) + i] -
                 bs.coordinates[3 * (size_t)(bs.spring_node - 1) + i]) > 1.e-8) {
            bs_fail("native two-point scalar spring must join points on its global force axis");
        }
    }
    free(parents);
    free(catalogue);
    free(contact_index);
}

static ITG bs_graph_term(ITG identity, ITG capacity)
{
    if (identity < 1 || identity > capacity) {
        bs_fail("native mixed MPC term is outside its actual storage");
    }
    return identity - 1;
}

static void bs_mixed_graph(ITG nmpc, ITG* ipompc, ITG* nodes, double* coefficients,
                           char* labels, ITG capacity)
{
    unsigned char *used, *received;
    size_t r, receiver, term, visited;
    ITG row, index, node, direction, expected_node, expected_direction;
    double expected, lever[3], axis[3], projected[3];
    if (capacity < 0 || capacity > INT_MAX / 3 || nmpc < 0 ||
        nmpc > capacity || bs_early.rigid_count != 3 * bs.receiver_count ||
        bs_early.input_mpcs != (ITG)bs_early.rigid_count) {
        bs_fail("mixed native input graph must contain only the one complete declared rigid body");
    }
    used = bs_allocate((size_t)capacity, 1);
    received = bs_allocate(bs_product(bs.receiver_count, 3), 1);
    bs.nmpc = nmpc;
    bs.rigid_row_index = bs_allocate((size_t)nmpc, sizeof(ITG));
    for (r = 0; r < bs_early.rigid_count; ++r) {
        BSRigid* rigid = bs_early.rigids + r;
        if (rigid->reference != bs.reference_node || rigid->rotation != bs.rotation_node ||
            rigid->direction < 1 || rigid->direction > 3 || rigid->row < 1 ||
            rigid->row > nmpc || rigid->auxiliary < 1 || rigid->auxiliary > bs.nk ||
            bs.solid_nodes[rigid->auxiliary - 1] || bs.beam_nodes[rigid->auxiliary - 1] ||
            rigid->auxiliary == bs.reference_node || rigid->auxiliary == bs.rotation_node ||
            bs.rigid_row_index[rigid->row - 1]) {
            bs_fail("native rigid row has an invalid, repeated or structurally attached identity");
        }
        for (receiver = 0; receiver < bs.receiver_count; ++receiver) {
            if (bs.receivers[receiver] == rigid->receiver) {
                break;
            }
        }
        if (receiver == bs.receiver_count ||
            received[3 * receiver + rigid->direction - 1]++) {
            bs_fail("native rigid receiving node/direction catalogue differs from the request");
        }
        bs.rigid_row_index[rigid->row - 1] = (ITG)r + 1;
        if (strncmp(labels + 20 * (size_t)(rigid->row - 1), "RIGID               ", 20)) {
            bs_fail("declared native rigid row lost its actual rigid-body provenance");
        }
        index = bs_graph_term(ipompc[rigid->row - 1], capacity);
        for (term = 0; term < 6; ++term) {
            if (used[index]) {
                bs_fail("native rigid terms overlap or contain a cycle");
            }
            used[index] = 1;
            expected_node = term == 0 ? rigid->receiver : term == 1 ? bs.reference_node :
                            term == 5 ? rigid->auxiliary : bs.rotation_node;
            expected_direction = term >= 2 && term <= 4 ? (ITG)term - 1 : rigid->direction;
            expected = term == 1 ? -1. : 1.;
            if (term >= 2 && term <= 4) {
                memset(axis, 0, sizeof(axis));
                axis[term - 2] = 1.;
                for (direction = 0; direction < 3; ++direction) {
                    lever[direction] = bs.coordinates[
                        3 * (size_t)(bs.reference_node - 1) + direction] -
                        bs.coordinates[3 * (size_t)(rigid->receiver - 1) + direction];
                }
                bs_cross(projected, axis, lever);
                expected = projected[rigid->direction - 1];
            }
            if (nodes[3 * (size_t)index] != expected_node ||
                nodes[3 * (size_t)index + 1] != expected_direction ||
                !isfinite(coefficients[index]) ||
                fabs(coefficients[index] - expected) > 1.e-12 * fmax(1., fabs(expected))) {
                bs_fail("actual native rigid equation differs from its declared physical port");
            }
            if ((term == 5) != (nodes[3 * (size_t)index + 2] == 0)) {
                bs_fail("native rigid equation has an incomplete or additional term");
            }
            if (term != 5) {
                index = bs_graph_term(nodes[3 * (size_t)index + 2], capacity);
            }
        }
    }
    for (row = 0; row < nmpc; ++row) {
        if (bs.rigid_row_index[row]) {
            continue;
        }
        if (strncmp(labels + 20 * (size_t)row, "                    ", 20) &&
            strncmp(labels + 20 * (size_t)row, "MEANROT", 7)) {
            bs_fail("mixed beam graph contains an unqualified native coupling");
        }
        index = bs_graph_term(ipompc[row], capacity);
        visited = 0;
        for (;;) {
            if (used[index] || ++visited > (size_t)capacity) {
                bs_fail("native beam graph term lists overlap or contain a cycle");
            }
            used[index] = 1;
            node = nodes[3 * (size_t)index];
            direction = nodes[3 * (size_t)index + 1];
            if (node < 1 || node > bs.nk || direction < 0 || direction > 3 ||
                !isfinite(coefficients[index])) {
                bs_fail("native beam graph has an invalid term or coefficient");
            }
            if (!bs.beam_nodes[node - 1]) {
                for (r = 0; r < bs_early.count; ++r) {
                    if (node == bs_early.angles[r].auxiliary && direction <= 2) {
                        break;
                    }
                }
                if (r == bs_early.count) {
                    bs_fail("beam MPC crosses into a solid, rigid port or unowned coordinate");
                }
            }
            if (!nodes[3 * (size_t)index + 2]) {
                break;
            }
            index = bs_graph_term(nodes[3 * (size_t)index + 2], capacity);
        }
    }
    free(received);
    free(used);
}

static void bs_coupled_supports(ITG nboun, ITG* nodes, ITG* directions,
                                double* values, ITG* amplitudes, char* types)
{
    ITG i, j, node, dir;
    int found[6] = {0}, angle_found[3] = {0}, algebraic_found[3] = {0};
    int guide_found[6] = {0};
    size_t a, r;
    unsigned char* fixed_found = bs_allocate(bs_product(bs.fixed_count, 3), 1);
    unsigned char* rigid_found = bs_allocate(bs_early.rigid_count, 1);
    for (a = 0; a < bs_early.count; ++a) {
        BSAngle* angle = bs_early.angles + a;
        if (angle->original != bs.support_node || angle->direction < 4 ||
            angle->direction > 6 || !bs.support_directions[angle->direction - 1] ||
            angle->auxiliary < 1 || angle->auxiliary > bs.nk) {
            bs_fail("native mean-rotation support has no declared author constraint");
        }
        for (j = 0; j < 3; ++j) {
            if (!isfinite(angle->axis[j]) ||
                fabs(angle->axis[j] - (j == angle->direction - 4)) > 1.e-12) {
                bs_fail("native support rotation axis differs from the requested global DOF");
            }
        }
        for (j = 0; j < (ITG)a; ++j) {
            if (bs_early.angles[j].direction == angle->direction ||
                bs_early.angles[j].auxiliary == angle->auxiliary) {
                bs_fail("repeated native mean-rotation support identity");
            }
        }
    }
    for (i = 0; i < nboun; ++i) {
        node = nodes[i];
        dir = directions[i];
        if (node < 1 || node > bs.nk || dir < 1 || dir > 6 ||
            values[i] != 0. || (amplitudes && amplitudes[i])) {
            bs_fail("coupled supports require finite zero unamplified mechanical constraints");
        }
        if (bs.coupled == 3 && dir <= 3 &&
            ((node == bs.reference_node && bs.guide_directions[dir - 1]) ||
             (node == bs.rotation_node && bs.guide_directions[dir + 2]))) {
            int logical = node == bs.reference_node ? dir - 1 : dir + 2;
            if (types[i] == 'R' || types[i] == 'U' || ++guide_found[logical] != 1) {
                bs_fail("physical port guide has a duplicate or algebraic native prescription");
            }
            continue;
        }
        if (node == bs.support_node && bs.support_directions[dir - 1]) {
            if (++found[dir - 1] != 1) {
                bs_fail("repeated original coupled support DOF");
            }
            continue;
        }
        for (a = 0; a < bs_early.count; ++a) {
            if (node == bs_early.angles[a].auxiliary && dir == 1) {
                if (++angle_found[a] != 1) {
                    bs_fail("repeated native angle support DOF");
                }
                break;
            }
            if (node == bs_early.angles[a].auxiliary && dir == 2 && types[i] == 'U') {
                if (++algebraic_found[a] != 1) {
                    bs_fail("repeated native algebraic support DOF");
                }
                break;
            }
        }
        if (a == bs_early.count) {
            if (bs.coupled >= 2 && dir <= 3 && bs.fixed_index[node - 1]) {
                r = 3 * (size_t)(bs.fixed_index[node - 1] - 1) + dir - 1;
                if (fixed_found[r]++) {
                    bs_fail("repeated physical tetrahedral support degree of freedom");
                }
                continue;
            }
            if (bs.coupled >= 2 && types[i] == 'R') {
                for (r = 0; r < bs_early.rigid_count; ++r) {
                    BSRigid* rigid = bs_early.rigids + r;
                    if (node == rigid->auxiliary && dir == rigid->direction) {
                        if (rigid_found[r]++) {
                            bs_fail("repeated native rigid algebraic support identity");
                        }
                        break;
                    }
                }
                if (r != bs_early.rigid_count) {
                    continue;
                }
            }
            bs_fail("native SPC is outside the complete declared physical/algebraic catalogue");
        }
    }
    for (j = 0; j < 6; ++j) {
        if (found[j] != bs.support_directions[j]) {
            bs_fail("declared original support DOF is missing from the native problem");
        }
        if (bs.coupled == 3 && guide_found[j] != bs.guide_directions[j]) {
            bs_fail("declared physical rigid port guide is incomplete");
        }
    }
    for (a = 0; a < bs_early.count; ++a) {
        if (angle_found[a] != 1 || algebraic_found[a] != 1) {
            bs_fail("native angle/algebraic support pair is incomplete");
        }
    }
    if (bs_early.count != 3) {
        bs_fail("coupled beam chain requires all three declared native root rotations");
    }
    for (r = 0; r < 3 * bs.fixed_count; ++r) {
        if (fixed_found[r] != 1) {
            bs_fail("native tetrahedral physical support catalogue is incomplete");
        }
    }
    for (r = 0; r < bs_early.rigid_count; ++r) {
        if (rigid_found[r] != 1) {
            bs_fail("native rigid-body algebraic prescription catalogue is incomplete");
        }
    }
    free(fixed_found);
    free(rigid_found);
}

static void bs_contact_catalogue(ITG count, char* sets, ITG* start, ITG* end,
                                  ITG* members, ITG capacity)
{
    static const int local[4][3] = {{0, 2, 1}, {0, 1, 3}, {1, 2, 3}, {0, 3, 2}};
    static const int opposite[4] = {3, 2, 0, 1};
    size_t r, k, receiver;
    ITG side, set, selected, first, last, entry, encoded;
    int normals_seen[2] = {0, 0};
    double normals[2][3] = {{0.}}, edge1[3], edge2[3], inward[3], norm, orientation;
    size_t requested[2] = {0, 0};
    unsigned char* seen = bs_allocate(bs.contact_face_count, 1);
    const char* contact_path = getenv("CCX_CONTACT_STATE_REQUEST");
    if (!bs.contact_owner[0] || !bs.contact_request[0] || !bs.guide_owner[0] ||
        strcmp(bs.guide_owner, bs.port_owner) || !contact_path || !*contact_path ||
        !bs_solid_owner_id(bs.contact_solid_owner[0]) ||
        !bs_solid_owner_id(bs.contact_solid_owner[1]) ||
        !strcmp(bs.contact_solid_owner[0], bs.contact_solid_owner[1]) ||
        !strcmp(bs.contact_surface[0], bs.contact_surface[1]) || count < 1 ||
        count > INT_MAX / 81 || capacity < 1 || !sets || !start || !end || !members) {
        bs_fail("contact composition requires a complete physical guide and authenticated native pair");
    }
    for (k = 0; k < 6; ++k) {
        if (bs.guide_directions[k] != (k != (size_t)bs.spring_direction - 1)) {
            bs_fail("physical rigid port guide must leave only the scalar translation free");
        }
    }
    for (r = 0; r < bs.contact_face_count; ++r) {
        BSContactFace* face = bs.contact_faces + r;
        BSSolid* solid = bs.solids + face->element - 1;
        if (!face->exterior || !solid->declared ||
            solid->owner != bs_solid_owner_id(bs.contact_solid_owner[face->side])) {
            bs_fail("selected contact face is not an exterior face of its declared true solid owner");
        }
        for (k = 0; k < 3; ++k) {
            ITG node = solid->nodes[local[face->face - 1][k]];
            if (bs.fixed_index[node - 1]) {
                bs_fail("physical fixed support cannot overlap a selected contact face");
            }
            for (receiver = 0; receiver < bs.receiver_count; ++receiver) {
                if (node == bs.receivers[receiver]) {
                    bs_fail("rigid receiving region cannot overlap a selected contact face");
                }
            }
            face->nodes[k] = node;
        }
        /* Derive outward geometry from this actual Tet4 and its opposite
         * vertex, independently of input winding or request-side names.
         * This bounded slice admits opposing axial interfaces only. */
        for (k = 0; k < 3; ++k) {
            double origin = bs.coordinates[3 * (size_t)(face->nodes[0] - 1) + k];
            edge1[k] = bs.coordinates[3 * (size_t)(face->nodes[1] - 1) + k] - origin;
            edge2[k] = bs.coordinates[3 * (size_t)(face->nodes[2] - 1) + k] - origin;
            inward[k] = bs.coordinates[3 * (size_t)(
                solid->nodes[opposite[face->face - 1]] - 1) + k] - origin;
        }
        bs_cross(face->normal, edge1, edge2);
        norm = orientation = 0.;
        for (k = 0; k < 3; ++k) {
            norm += face->normal[k] * face->normal[k];
            orientation += face->normal[k] * inward[k];
        }
        norm = sqrt(norm);
        if (!isfinite(norm) || norm <= 0. || !isfinite(orientation) || orientation == 0.) {
            bs_fail("selected native contact face has zero area or degenerate tetrahedral geometry");
        }
        for (k = 0; k < 3; ++k) {
            face->normal[k] /= orientation > 0. ? -norm : norm;
            if ((k == (size_t)bs.spring_direction - 1 &&
                 fabs(fabs(face->normal[k]) - 1.) > 1.e-10) ||
                (k != (size_t)bs.spring_direction - 1 && fabs(face->normal[k]) > 1.e-10)) {
                bs_fail("contact composition requires native outward normals along the scalar axis");
            }
            if (normals_seen[face->side] &&
                fabs(normals[face->side][k] - face->normal[k]) > 1.e-10) {
                bs_fail("each native contact side must have one consistent outward normal");
            }
            normals[face->side][k] = face->normal[k];
        }
        normals_seen[face->side] = 1;
        bs_sort_nodes(face->nodes);
        ++requested[face->side];
    }
    for (k = 0; k < 3; ++k) {
        if (!normals_seen[0] || !normals_seen[1] ||
            fabs(normals[0][k] + normals[1][k]) > 1.e-10) {
            bs_fail("selected native contact owner faces must have opposing outward normals");
        }
    }
    for (side = 0; side < 2; ++side) {
        selected = -1;
        for (set = 0; set < count; ++set) {
            char name[81];
            size_t length = 0;
            while (length < 81 && sets[81 * (size_t)set + length] != ' ') {
                ++length;
            }
            if (length < 2 || length > 80 || sets[81 * (size_t)set + length - 1] != 'T') {
                continue;
            }
            memcpy(name, sets + 81 * (size_t)set, length - 1);
            name[length - 1] = '\0';
            if (bs_same_name(name, bs.contact_surface[side])) {
                if (selected >= 0) {
                    bs_fail("selected native contact surface name is ambiguous");
                }
                selected = set;
            }
        }
        if (selected < 0 || !requested[side]) {
            bs_fail("selected native contact surface is missing or empty");
        }
        first = start[selected]; last = end[selected];
        if (first < 1 || last < first || last > capacity ||
            (size_t)(last - first + 1) != requested[side]) {
            bs_fail("native contact surface differs from its complete declared face catalogue");
        }
        for (entry = first; entry <= last; ++entry) {
            encoded = members[entry - 1];
            if (encoded < 1) {
                bs_fail("native contact surface requires explicit original face identities");
            }
            for (r = 0; r < bs.contact_face_count; ++r) {
                BSContactFace* face = bs.contact_faces + r;
                if (face->side == side && face->element == encoded / 10 &&
                    face->face == encoded % 10) {
                    if (seen[r]++) {
                        bs_fail("native selected contact face is repeated");
                    }
                    break;
                }
            }
            if (r == bs.contact_face_count) {
                bs_fail("native selected contact surface contains an undeclared face");
            }
        }
    }
    for (r = 0; r < bs.contact_face_count; ++r) {
        if (seen[r] != 1) {
            bs_fail("declared contact face is absent from its actual native surface");
        }
    }
    free(seen);
    qsort(bs.contact_faces, bs.contact_face_count, sizeof(BSContactFace), bs_contact_face_order);
    for (r = 1; r < bs.contact_face_count; ++r) {
        if (!bs_contact_face_order(bs.contact_faces + r - 1, bs.contact_faces + r)) {
            bs_fail("native contact face nodes have ambiguous selected ownership");
        }
    }
}

void bs_prepare(ITG method, ITG* perturb, ITG thermal, ITG transforms,
                ITG cyclic, ITG step, ITG nk, ITG ne, ITG nkon,
                ITG* ipkon, ITG* kon, char* lakon, char* filab, double* co,
                ITG nboun, ITG* nodeboun, ITG* ndirboun, double* xboun,
                ITG* iamboun, char* typeboun, ITG nmpc, char* labmpc,
                ITG nload, ITG nbody, ITG ntie, ITG prestress,
                ITG material_stride, ITG* materials, ITG* ipompc,
                ITG* nodempc, double* coefficients, ITG mpc_capacity,
                ITG nset, char* sets, ITG* set_start, ITG* set_end, ITG* set_members,
                ITG set_capacity)
{
    const char* path = getenv("CCX_BEAM_SECTION_REQUEST");
    FILE* stream;
    char token[81], *tail, *output, *temporary;
    struct stat info;
    ITG element, node, k, index;
    int byte;
    size_t count = 0, springs = 0, solids = 0, i;
    if (!path) {
        return;
    }
    if (!*path || bs.active || strlen(path) > 4096) {
        bs_fail("requires a nonempty request path and one standalone step");
    }
    if (method != 1 || perturb[1] || thermal > 1 || transforms || cyclic || step != 1) {
        bs_fail("requires one small-displacement global mechanical static step");
    }
    if (nk < 1 || ne < 1 || nkon < 23 ||
        strncmp(filab + 174, "S   ", 4) || filab[178] != 'M' || filab[179] == 'L') {
        bs_fail("requires native B32R SECTION FORCES with global source stresses");
    }
    if (lstat(path, &info) || !S_ISREG(info.st_mode)) {
        bs_fail("request must be a regular non-symlink file");
    }
    bs.path = bs_allocate(strlen(path) + 1, 1);
    strcpy(bs.path, path);
    output = bs_suffix(".out");
    temporary = bs_suffix(".out.tmp");
    bs_absent(output);
    bs_absent(temporary);
    free(output);
    free(temporary);
    bs.ne = ne;
    bs.nk = nk;
    bs.elements = bs_allocate((size_t)ne, sizeof(BSElement));
    stream = fopen(path, "r");
    if (!stream) {
        bs_fail("cannot read request");
    }
    while ((byte = fgetc(stream)) != EOF) {
        if (!byte || (byte < 32 && byte != '\n' && byte != '\r' && byte != '\t')) {
            bs_fail("request contains a non-text byte");
        }
    }
    if (ferror(stream) || fseek(stream, 0, SEEK_SET)) {
        bs_fail("cannot inspect or rewind request");
    }
    bs_token(stream, token);
    if (!strcmp(token, "CCX_BEAM_SECTION_V2")) {
        bs.coupled = 1;
    }
    else if (!strcmp(token, "CCX_BEAM_SECTION_V3") ||
             !strcmp(token, "CCX_BEAM_SECTION_V4")) {
        bs.coupled = !strcmp(token, "CCX_BEAM_SECTION_V4") ? 3 : 2;
        bs.solids = bs_allocate((size_t)ne, sizeof(BSSolid));
        bs.solid_nodes = bs_allocate((size_t)nk, 1);
    }
    else if (strcmp(token, "CCX_BEAM_SECTION_V1")) {
        bs_fail("unsupported native beam request schema");
    }
    for (element = 0; element < ne; ++element) {
        if (ipkon[element] < 0) {
            continue;
        }
        if (bs.coupled && !strncmp(lakon + 8 * (size_t)element,
                                    bs.coupled >= 2 ? "ESPRNG21" : "ESPRNG10", 8)) {
            if (ipkon[element] > nkon - (bs.coupled >= 2 ? 2 : 1) || ++springs != 1) {
                bs_fail("coupled beam request requires exactly one declared native scalar spring");
            }
            continue;
        }
        if (bs.coupled >= 2 && !strncmp(lakon + 8 * (size_t)element, "C3D4    ", 8)) {
            if (ipkon[element] > nkon - 4) {
                bs_fail("native mixed tetrahedral connectivity exceeds its actual storage");
            }
            ++solids;
            continue;
        }
        if (strncmp(lakon + 8 * (size_t)element, "C3D20RB", 7) ||
            ipkon[element] > nkon - 23) {
            bs_fail("only active expanded B32R elements are supported");
        }
        ++count;
    }
    if (!count || (bs.coupled && springs != 1) || (bs.coupled >= 2 && !solids)) {
        bs_fail("missing active B32R chain or native grounded spring");
    }
    bs_expect(stream, "REQUEST");
    bs_token(stream, token);
    if (strlen(token) != 32) {
        bs_fail("request identity must be 32 lowercase hexadecimal characters");
    }
    for (i = 0; i < 32; ++i) {
        if (!(token[i] >= '0' && token[i] <= '9') &&
            !(token[i] >= 'a' && token[i] <= 'f')) {
            bs_fail("request identity must be 32 lowercase hexadecimal characters");
        }
    }
    memcpy(bs.request, token, 33);
    bs_expect(stream, "END_TIME");
    bs_token(stream, token);
    errno = 0;
    bs.end_time = strtod(token, &tail);
    if (errno || *tail || !isfinite(bs.end_time) || bs.end_time <= 0.) {
        bs_fail("requires a finite positive requested end time");
    }
    bs_expect(stream, "UNITS");
    bs_expect(stream, "MM");
    bs_expect(stream, "N");
    bs_expect(stream, "NMM");
    for (;;) {
        bs_token(stream, token);
        if (!strcmp(token, "END")) {
            break;
        }
        if (bs.coupled && !strcmp(token, bs.coupled >= 2 ? "SPRING2" : "SPRING")) {
            if (bs.spring_element) {
                bs_fail("repeated coupled spring declaration");
            }
            bs_owner(stream, bs.spring_owner);
            bs.spring_element = bs_integer(stream);
            bs.spring_node = bs_integer(stream);
            if (bs.coupled >= 2) {
                ITG reference = bs_integer(stream);
                if (bs.reference_node && reference != bs.reference_node) {
                    bs_fail("mixed spring and rigid port reference identities differ");
                }
                bs.reference_node = reference;
            }
            bs.spring_direction = bs_integer(stream);
            element = bs.spring_element - 1;
            if (element >= ne || ipkon[element] < 0 ||
                strncmp(lakon + 8 * (size_t)element,
                        bs.coupled >= 2 ? "ESPRNG21" : "ESPRNG10", 8) ||
                bs.spring_direction > 3 || bs.spring_node > nk ||
                kon[ipkon[element]] != bs.spring_node ||
                (bs.coupled >= 2 && (bs.reference_node > nk ||
                 kon[(size_t)ipkon[element] + 1] != bs.reference_node))) {
                bs_fail("coupled scalar spring declaration differs from its native element");
            }
            continue;
        }
        if (bs.coupled >= 2 && !strcmp(token, "SOLID")) {
            char owner[81];
            int owner_id;
            bs_owner(stream, owner);
            if (!bs.solid_owner[0]) {
                memcpy(bs.solid_owner, owner, strlen(owner) + 1);
                bs.solid_owner_count = 1;
            }
            owner_id = bs_solid_owner_id(owner);
            if (!owner_id && bs.coupled == 3 && bs.solid_owner_count == 1) {
                memcpy(bs.second_solid_owner, owner, strlen(owner) + 1);
                bs.solid_owner_count = 2;
                owner_id = 2;
            }
            if (!owner_id) {
                bs_fail("mixed beam domain has an undeclared additional tetrahedral body owner");
            }
            element = bs_integer(stream);
            if (element > ne || bs.solids[element - 1].declared || ipkon[element - 1] < 0 ||
                strncmp(lakon + 8 * (size_t)(element - 1), "C3D4    ", 8)) {
                bs_fail("unknown, repeated or non-tetrahedral declared solid element");
            }
            for (k = 0; k < 4; ++k) {
                ITG previous;
                node = bs_integer(stream);
                if (node > nk || node != kon[(size_t)ipkon[element - 1] + k]) {
                    bs_fail("declared tetrahedron differs from native connectivity");
                }
                for (previous = 0; previous < k; ++previous) {
                    if (bs.solids[element - 1].nodes[previous] == node) {
                        bs_fail("tetrahedron has repeated native node identities");
                    }
                }
                bs.solids[element - 1].nodes[k] = node;
                if (bs.solid_nodes[node - 1] && bs.solid_nodes[node - 1] != owner_id) {
                    bs_fail("contact body owners require disjoint structural node identities");
                }
                bs.solid_nodes[node - 1] = (unsigned char)owner_id;
            }
            bs.solids[element - 1].declared = 1;
            bs.solids[element - 1].owner = owner_id;
            ++bs.solid_count;
            continue;
        }
        if (bs.coupled >= 2 && !strcmp(token, "SPC_SUPPORT")) {
            if (bs.fixed_nodes) {
                bs_fail("repeated physical tetrahedral support declaration");
            }
            bs_owner(stream, bs.fixed_owner);
            bs.fixed_nodes = bs_node_list(stream, &bs.fixed_count);
            continue;
        }
        if (bs.coupled >= 2 && !strcmp(token, "PORT")) {
            ITG reference;
            if (bs.receivers) {
                bs_fail("repeated mixed rigid port declaration");
            }
            bs_owner(stream, bs.port_owner);
            reference = bs_integer(stream);
            if (bs.reference_node && reference != bs.reference_node) {
                bs_fail("mixed spring and rigid port reference identities differ");
            }
            bs.reference_node = reference;
            reference = bs_integer(stream);
            if (bs.rotation_node && bs.rotation_node != reference) {
                bs_fail("mixed port rotation identities differ");
            }
            bs.rotation_node = reference;
            bs.receivers = bs_node_list(stream, &bs.receiver_count);
            continue;
        }
        if (bs.coupled == 3 && !strcmp(token, "PORT_GUIDE")) {
            ITG reference, rotation, directions, direction;
            if (bs.guide_owner[0]) {
                bs_fail("repeated physical rigid port guide");
            }
            bs_owner(stream, bs.guide_owner);
            reference = bs_integer(stream);
            rotation = bs_integer(stream);
            if ((bs.reference_node && reference != bs.reference_node) ||
                (bs.rotation_node && rotation != bs.rotation_node)) {
                bs_fail("physical guide differs from the declared rigid reference/rotation port");
            }
            bs.reference_node = reference;
            bs.rotation_node = rotation;
            directions = bs_integer(stream);
            if (directions != 2) {
                bs_fail("physical port guide requires two transverse zero translations");
            }
            for (k = 0; k < directions; ++k) {
                direction = bs_integer(stream);
                if (direction > 3 || bs.guide_directions[direction - 1]) {
                    bs_fail("invalid or repeated physical port guide translation");
                }
                bs.guide_directions[direction - 1] = 1;
            }
            if (bs_integer(stream) != 3) {
                bs_fail("physical port guide requires three zero rotations");
            }
            for (k = 0; k < 3; ++k) {
                direction = bs_integer(stream);
                if (direction > 3 || bs.guide_directions[direction + 2]) {
                    bs_fail("invalid or repeated physical port guide rotation");
                }
                bs.guide_directions[direction + 2] = 1;
            }
            continue;
        }
        if (bs.coupled == 3 && !strcmp(token, "CONTACT")) {
            if (bs.contact_owner[0]) {
                bs_fail("one complete ordinary contact pair is required");
            }
            bs_owner(stream, bs.contact_owner);
            bs_owner(stream, bs.contact_solid_owner[0]);
            bs_owner(stream, bs.contact_solid_owner[1]);
            bs_owner(stream, bs.contact_surface[0]);
            bs_owner(stream, bs.contact_surface[1]);
            continue;
        }
        if (bs.coupled == 3 && !strcmp(token, "CONTACT_FACE")) {
            BSContactFace* replacement;
            BSContactFace face = {0};
            bs_token(stream, token);
            if (!strcmp(token, "SLAVE")) {
                face.side = 0;
            }
            else if (!strcmp(token, "MASTER")) {
                face.side = 1;
            }
            else {
                bs_fail("contact face requires an explicit master/slave side");
            }
            face.element = bs_integer(stream);
            face.face = bs_integer(stream);
            if (face.element > bs.ne || face.face > 4 ||
                bs.contact_face_count >= bs_product((size_t)bs.ne, 4)) {
                bs_fail("contact face declaration is outside the tetrahedral catalogue");
            }
            replacement = realloc(bs.contact_faces,
                bs_product(bs.contact_face_count + 1, sizeof(BSContactFace)));
            if (!replacement) {
                bs_fail("cannot retain native contact face declarations");
            }
            bs.contact_faces = replacement;
            bs.contact_faces[bs.contact_face_count++] = face;
            continue;
        }
        if (bs.coupled == 3 && !strcmp(token, "CONTACT_REQUEST")) {
            if (bs.contact_request[0]) {
                bs_fail("repeated contact request binding");
            }
            bs_token(stream, token);
            if (strlen(token) != 32) {
                bs_fail("contact child request identity must have 32 hexadecimal characters");
            }
            for (i = 0; i < 32; ++i) {
                if (!(token[i] >= '0' && token[i] <= '9') &&
                    !(token[i] >= 'a' && token[i] <= 'f')) {
                    bs_fail("contact child request identity must be lowercase hexadecimal");
                }
            }
            memcpy(bs.contact_request, token, 33);
            continue;
        }
        if (bs.coupled && !strcmp(token, "SOURCE")) {
            if (bs.source_node) {
                bs_fail("repeated coupled source declaration");
            }
            bs_owner(stream, bs.source_owner);
            bs.source_node = bs_integer(stream);
            continue;
        }
        if (bs.coupled && !strcmp(token, "SUPPORT")) {
            ITG directions, direction;
            if (bs.support_node) {
                bs_fail("repeated coupled physical support declaration");
            }
            bs_owner(stream, bs.support_owner);
            bs.support_node = bs_integer(stream);
            directions = bs_integer(stream);
            if (directions != 5) {
                bs_fail("coupled root requires five zero stabilizing degrees of freedom");
            }
            for (k = 0; k < directions; ++k) {
                direction = bs_integer(stream);
                if (direction > 6 || bs.support_directions[direction - 1]) {
                    bs_fail("invalid or repeated coupled root support direction");
                }
                bs.support_directions[direction - 1] = 1;
            }
            continue;
        }
        if (strcmp(token, "ELEMENT")) {
            bs_fail("expected an ELEMENT record or END");
        }
        element = bs_integer(stream);
        if (element > ne || ipkon[element - 1] < 0 || bs.elements[element - 1].declared ||
            strncmp(lakon + 8 * (size_t)(element - 1), "C3D20RB", 7)) {
            bs_fail("duplicate, inactive or unknown requested element");
        }
        index = ipkon[element - 1] + 20;
        for (k = 0; k < 3; ++k) {
            node = bs_integer(stream);
            if (node > nk || node != kon[index + k]) {
                bs_fail("requested B32R connectivity differs from the native expansion");
            }
            bs.elements[element - 1].nodes[k] = node;
        }
        if (bs.elements[element - 1].nodes[0] == bs.elements[element - 1].nodes[1] ||
            bs.elements[element - 1].nodes[0] == bs.elements[element - 1].nodes[2] ||
            bs.elements[element - 1].nodes[1] == bs.elements[element - 1].nodes[2]) {
            bs_fail("repeated nodes in requested beam");
        }
        bs.elements[element - 1].declared = 1;
        ++bs.count;
    }
    if (fscanf(stream, "%80s", token) != EOF || ferror(stream) || fclose(stream) ||
        bs.count != count || bs.solid_count != solids) {
        bs_fail("request must declare the complete native B32R catalogue exactly once");
    }
    if (bs.coupled) {
        if (!bs.spring_element || !bs.source_node || !bs.support_node ||
            bs.support_directions[bs.spring_direction - 1] ||
            nload || nbody || (bs.coupled == 3 ? ntie != 1 : ntie != 0) ||
            prestress || thermal || iamboun ||
            nk > INT_MAX / 3 || nmpc < 0 || !materials ||
            !bs_early.input_seen || (bs.coupled == 1 && bs_early.input_mpcs != 0)) {
            bs_fail("coupled domain requires one point source and zero prescribed supports");
        }
        for (element = 0; element < nmpc; ++element) {
            if (strncmp(labmpc + 20 * (size_t)element, "                    ", 20) &&
                strncmp(labmpc + 20 * (size_t)element, "MEANROT", 7) &&
                (bs.coupled < 2 ||
                 strncmp(labmpc + 20 * (size_t)element, "RIGID               ", 20))) {
                bs_fail("coupled beam domain does not support knots or user-defined couplings");
            }
        }
        bs.coordinates = bs_allocate(3 * (size_t)nk, sizeof(double));
        for (i = 0; i < 3 * (size_t)nk; ++i) {
            if (!isfinite(co[i])) {
                bs_fail("nonfinite native original coordinates");
            }
            bs.coordinates[i] = co[i];
        }
        bs_coupled_geometry(ipkon, kon, lakon, material_stride, materials);
        if (bs.coupled >= 2) {
            bs_mixed_geometry(ipkon, kon);
            bs_mixed_graph(nmpc, ipompc, nodempc, coefficients, labmpc, mpc_capacity);
        }
        if (bs.coupled == 3) {
            bs_contact_catalogue(nset, sets, set_start, set_end, set_members, set_capacity);
        }
        bs_coupled_supports(nboun, nodeboun, ndirboun, xboun, iamboun, typeboun);
    }
    bs.samples = bs_allocate(bs_product((size_t)ne, 2), sizeof(BSSample));
    if (atexit(bs_finish)) {
        bs_fail("cannot register final-frame validation");
    }
    bs.active = 1;
}

int bs_contact_mesh_authorized(ITG element, const char* label)
{
    if (!bs.active || bs.coupled != 3 || element < 1 || element > bs.ne) {
        return 0;
    }
    return (bs.elements[element - 1].declared && !strncmp(label, "C3D20RB", 7)) ||
           (element == bs.spring_element && !strncmp(label, "ESPRNG21", 8));
}

void bs_contact_authorize(const char* request, const char* owner,
                          const char* slave, const char* master,
                          ITG pairs, ITG native_pair, double end_time, double law)
{
    if (!bs.active || bs.coupled != 3) {
        return;
    }
    if (bs.contact_authorized || pairs != 1 || native_pair != 0 ||
        !isfinite(law) || law < 2. || law >= 3. ||
        end_time != bs.end_time || strcmp(request, bs.contact_request) ||
        strcmp(owner, bs.contact_owner) ||
        !bs_same_name(slave, bs.contact_surface[0]) ||
        !bs_same_name(master, bs.contact_surface[1])) {
        bs_fail("contact child identity, pair, law or time differs from the validated mixed request");
    }
    bs.contact_authorized = 1;
}

/* Only retained result evaluations own these slots. Each worker writes its
 * own native contact element, then the serial contact-frame handoff reduces
 * the observed values. No shared nodal or owner += occurs in a worker. */
void bs_begin_contacts(ITG ne, ITG* ipkon, ITG* kon, char* lakon)
{
    ITG element, point, side, j, index, total;
    size_t maximum = 0;
    if (!bs.active || bs.coupled != 3 || !bs.actions_capturing) {
        return;
    }
    if (!bs.contact_authorized || ne < bs.ne || ne > INT_MAX / 12) {
        bs_fail("invalid retained contact element capacity");
    }
    free(bs.contact_slots);
    free(bs.contact_point_index);
    bs.contact_slots = bs_allocate((size_t)ne, sizeof(BSContactSlot));
    bs.contact_capacity = (size_t)ne;
    bs.contact_count = 0;
    for (element = bs.ne; element < ne; ++element) {
        BSContactSlot* slot = bs.contact_slots + element;
        if (ipkon[element] < 1 || strncmp(lakon + 8 * (size_t)element, "ESPRNGC3", 8)) {
            bs_fail("mixed results contain an undeclared generated non-Tet4 contact element");
        }
        index = ipkon[element];
        total = kon[index - 1];
        if (total != 6 || index > INT_MAX - total - 3) {
            bs_fail("mixed contact requires actual three-node master and slave faces");
        }
        point = kon[(size_t)index + total];
        if (point < 1 || point > INT_MAX / 6) {
            bs_fail("mixed contact has an invalid native point identity");
        }
        slot->point = point;
        for (side = 0; side < 2; ++side) {
            BSContactFace key = {0};
            BSContactFace* face;
            key.side = side;
            for (j = 0; j < 3; ++j) {
                /* Native connectivity stores master first, then slave. */
                key.nodes[j] = kon[(size_t)index + (side ? 0 : 3) + j];
            }
            bs_sort_nodes(key.nodes);
            face = bsearch(&key, bs.contact_faces, bs.contact_face_count,
                           sizeof(BSContactFace), bs_contact_face_order);
            if (!face) {
                bs_fail("generated native contact side is outside its selected true-solid face");
            }
            slot->faces[side] = (ITG)(face - bs.contact_faces);
        }
        slot->declared = 1;
        ++bs.contact_count;
        maximum = maximum > (size_t)point ? maximum : (size_t)point;
    }
    bs.contact_point_capacity = maximum;
    bs.contact_point_index = bs_allocate(maximum, sizeof(ITG));
    for (element = bs.ne; element < ne; ++element) {
        BSContactSlot* slot = bs.contact_slots + element;
        if (bs.contact_point_index[slot->point - 1]) {
            bs_fail("two generated contact elements share one native sample identity");
        }
        bs.contact_point_index[slot->point - 1] = element + 1;
    }
}

void FORTRAN(bs_contact, (ITG* element, ITG* count, ITG* nodes,
                           double* fnl, char* label, ITG* point))
{
    BSContactSlot* slot;
    ITG side, j, k;
    if (!bs.active || bs.coupled != 3 || !bs.actions_capturing) {
        return;
    }
    if (*element < 1 || (size_t)*element > bs.contact_capacity || *count != 6 ||
        strncmp(label, "ESPRNGC3", 8)) {
        bs_fail("actual native contact callback is outside its declared catalogue");
    }
    slot = bs.contact_slots + *element - 1;
    if (!slot->declared || slot->seen || slot->point != *point) {
        bs_fail("actual native contact sample is missing, repeated or mismatched");
    }
    for (side = 0; side < 2; ++side) {
        BSContactFace key = {0};
        const BSContactFace* expected = bs.contact_faces + slot->faces[side];
        key.side = side;
        for (j = 0; j < 3; ++j) {
            ITG index = (side ? 0 : 3) + j;
            ITG node = nodes[index];
            double force[3], moment[3];
            if (node < 1 || node > bs.nk) {
                bs_fail("actual native contact node is outside original structural coordinates");
            }
            key.nodes[j] = node;
            for (k = 0; k < 3; ++k) {
                force[k] = -fnl[3 * (size_t)index + k];
                if (!isfinite(force[k])) {
                    bs_fail("nonfinite native contact nodal force");
                }
            }
            bs_cross(moment, bs.coordinates + 3 * (size_t)(node - 1), force);
            for (k = 0; k < 3; ++k) {
                slot->force[side][k] += force[k];
                slot->moment[side][k] += moment[k];
            }
        }
        bs_sort_nodes(key.nodes);
        if (bs_contact_face_order(&key, expected)) {
            bs_fail("native contact callback changed original face connectivity");
        }
    }
    slot->seen = 1;
}

void bs_contact_sample(ITG point, ITG slave_element, ITG slave_face,
                       ITG master_element, ITG master_face, ITG generated)
{
    ITG element = 0;
    BSContactSlot* slot;
    const BSContactFace *slave, *master;
    if (!bs.active || bs.coupled != 3) {
        return;
    }
    if (!bs.actions_capturing || point < 1) {
        bs_fail("native contact sample handoff is outside its retained action evaluation");
    }
    if ((size_t)point <= bs.contact_point_capacity) {
        element = bs.contact_point_index[point - 1];
    }
    if (!generated) {
        if (element) {
            bs_fail("native inactive contact sample unexpectedly has an assembled contact element");
        }
        return;
    }
    if (!element || (size_t)element > bs.contact_capacity) {
        bs_fail("native active contact sample has no matching mechanical contact element");
    }
    slot = bs.contact_slots + element - 1;
    slave = bs.contact_faces + slot->faces[0];
    master = bs.contact_faces + slot->faces[1];
    if (!slot->seen || slot->matched || slave_element != slave->element ||
        slave_face != slave->face || master_element != master->element ||
        master_face != master->face) {
        bs_fail("native contact state and assembled force have different sample/face identities");
    }
    slot->matched = 1;
}

void bs_contact_frame(ITG step, ITG increment, double time, const char* request)
{
    size_t element, side, k, observed = 0;
    if (!bs.active || bs.coupled != 3) {
        return;
    }
    if (!bs.actions_capturing || bs.actions.contact_seen ||
        step != bs.action_step || increment != bs.action_increment ||
        time != bs.action_time || strcmp(request, bs.contact_request)) {
        bs_fail("native contact state frame differs from the mechanical action evaluation");
    }
    for (element = (size_t)bs.ne; element < bs.contact_capacity; ++element) {
        const BSContactSlot* slot = bs.contact_slots + element;
        if (!slot->declared || !slot->seen || !slot->matched) {
            bs_fail("native contact mechanical/sample catalogue is incomplete");
        }
        ++observed;
        for (side = 0; side < 2; ++side) {
            for (k = 0; k < 3; ++k) {
                bs.actions.contact_force[side][k] += slot->force[side][k];
                bs.actions.contact_moment[side][k] += slot->moment[side][k];
                if (!isfinite(bs.actions.contact_force[side][k]) ||
                    !isfinite(bs.actions.contact_moment[side][k])) {
                    bs_fail("native contact side action overflow");
                }
            }
        }
    }
    if (observed != bs.contact_count) {
        bs_fail("native contact mechanical catalogue count changed");
    }
    bs.actions.contact_seen = 1;
}

static void bs_compression_source(int retained)
{
    size_t face, k, observed = 0;
    int owner = bs.solid_nodes[bs.receivers[0] - 1];
    double dot;
    if (bs.pointload[0] == 0. && bs.pointload[1] == 0. && bs.pointload[2] == 0.) {
        /* Native preliminary evaluations can precede application of load.
         * A retained compression result must contain its actual load. */
        if (retained) {
            bs_fail("retained contact compression requires a nonzero native point source");
        }
        return;
    }
    for (face = 0; face < bs.contact_face_count; ++face) {
        const BSContactFace* selected = bs.contact_faces + face;
        if (bs.solids[selected->element - 1].owner != owner) {
            continue;
        }
        ++observed;
        dot = 0.;
        for (k = 0; k < 3; ++k) {
            dot += bs.pointload[k] * selected->normal[k];
        }
        if (!isfinite(dot) || dot <= 0.) {
            bs_fail("actual native point source must compress the loaded solid contact interface");
        }
    }
    if (!observed) {
        bs_fail("rigid receiving owner has no selected native contact interface");
    }
}

void bs_pointloads(ITG count, ITG* nodes, ITG* directions, double* values,
                   ITG nload, ITG nbody)
{
    ITG i, direction;
    if (!bs.active || !bs.coupled) {
        return;
    }
    if (nload || nbody || count < 1) {
        bs_fail("coupled beam accounting supports actual native point loads only");
    }
    memset(bs.pointload, 0, sizeof(bs.pointload));
    for (i = 0; i < count; ++i) {
        direction = directions[i];
        if (nodes[2 * (size_t)i] != bs.source_node || nodes[2 * (size_t)i + 1] ||
            direction < 1 || direction > 3 || !isfinite(values[i]) ||
            !isfinite(bs.pointload[direction - 1] + values[i])) {
            bs_fail("actual native point source differs from the declared free beam endpoint");
        }
        bs.pointload[direction - 1] += values[i];
    }
    if (bs.coupled == 3) {
        for (direction = 1; direction <= 3; ++direction) {
            if (direction != bs.spring_direction && bs.pointload[direction - 1] != 0.) {
                bs_fail("contact composition supports only its declared axial point source");
            }
        }
        bs_compression_source(0);
    }
    bs.pointloads_seen = 1;
}

void bs_begin_actions(ITG iout, ITG step, ITG increment, double time, double* v)
{
    if (!bs.active || !bs.coupled) {
        return;
    }
    bs.actions_capturing = 0;
    if (iout != 1 && iout != 2) {
        return;
    }
    if (bs.coupled == 3 && (iout != 2 || !bs.contact_authorized)) {
        if (!bs.contact_authorized) {
            bs_fail("contact composition has no authenticated native contact request");
        }
        return;
    }
    if (step != 1 || increment < 1 || !isfinite(time) || time <= 0. ||
        time > bs.end_time || !bs.pointloads_seen) {
        bs_fail("invalid retained native mechanical action frame");
    }
    if (bs.coupled == 3) {
        bs_compression_source(1);
    }
    memset(&bs.actions, 0, sizeof(bs.actions));
    if (bs.coupled >= 2) {
        bs.actions.solid_spcs = bs_allocate(bs_product(bs.fixed_count, 3), sizeof(BSSPC));
        bs.actions.rigid_spcs = bs_allocate(bs_early.rigid_count, sizeof(BSRigidSPC));
        bs.actions.rigid_terms = bs_allocate(bs_early.rigid_count, 1);
    }
    memcpy(bs.actions.source, bs.pointload, sizeof(bs.pointload));
    bs_cross(bs.actions.source_moment,
             bs.coordinates + 3 * (size_t)(bs.source_node - 1), bs.actions.source);
    bs.action_step = step;
    bs.action_increment = increment;
    bs.action_time = time;
    bs.frame_displacements = v;
    bs.actions_capturing = 1;
}

/* This guard runs before native xn(idof)/a(:,idof) indexing. An unsupported
 * rotational DOF must be refused before the upstream three-entry access. */
void FORTRAN(bs_spring_law, (ITG* element, ITG* node, ITG* direction, ITG* kind,
                             ITG* tables, double* stiffness))
{
    if (!bs.active || !bs.coupled) {
        return;
    }
    if (*element != bs.spring_element || *node != bs.spring_node ||
        *direction < 1 || *direction > 3 || *direction != bs.spring_direction ||
        *kind != 2 || *tables != 1 || !isfinite(*stiffness) || *stiffness <= 0.) {
        bs_fail("native grounded spring requires the declared positive linear translational law");
    }
}

void FORTRAN(bs_spring, (ITG* element, ITG* node, ITG* direction, ITG* kind,
                         ITG* tables, double* stiffness, double* axis,
                         double* force, double* displacement))
{
    size_t k;
    if (!bs.active || !bs.coupled) {
        return;
    }
    if (*element != bs.spring_element || *node != bs.spring_node ||
        *direction != bs.spring_direction || *kind != 2 || *tables != 1 ||
        !isfinite(*stiffness) || *stiffness <= 0.) {
        bs_fail("native grounded spring requires the declared positive linear scalar law");
    }
    for (k = 0; k < 3; ++k) {
        if (!isfinite(axis[k]) || fabs(axis[k] - (k == (size_t)(*direction - 1))) > 1.e-12) {
            bs_fail("native grounded spring must follow its declared global translation axis");
        }
    }
    if (!bs.actions_capturing) {
        return;
    }
    if (bs.actions.spring_seen) {
        bs_fail("repeated grounded spring action in one retained native frame");
    }
    for (k = 0; k < 3; ++k) {
        if (!isfinite(force[k]) || !isfinite(displacement[k])) {
            bs_fail("nonfinite native grounded spring action or translation");
        }
        bs.actions.spring[k] = force[k];
        bs.actions.displacement[k] = displacement[k];
    }
    bs_cross(bs.actions.spring_moment,
             bs.coordinates + 3 * (size_t)(bs.spring_node - 1), bs.actions.spring);
    bs.actions.spring_seen = 1;
}

void FORTRAN(bs_spring2_law, (ITG* element, ITG* nodes, ITG* first, ITG* second,
                              ITG* kind, ITG* tables, double* stiffness))
{
    if (!bs.active || bs.coupled < 2) {
        return;
    }
    if (*element != bs.spring_element || nodes[0] != bs.spring_node ||
        nodes[1] != bs.reference_node || *first < 1 || *first > 3 ||
        *first != bs.spring_direction || *second != *first || *kind != 2 ||
        *tables != 1 || !isfinite(*stiffness) || *stiffness <= 0.) {
        bs_fail("native mixed connector requires the declared positive linear translational law");
    }
}

void FORTRAN(bs_spring2, (ITG* element, ITG* nodes, double* first_axis, double* second_axis,
                          double* force, double* first_displacement, double* second_displacement))
{
    size_t k;
    if (!bs.active || bs.coupled < 2) {
        return;
    }
    if (*element != bs.spring_element || nodes[0] != bs.spring_node ||
        nodes[1] != bs.reference_node) {
        bs_fail("observed native mixed connector identities changed");
    }
    for (k = 0; k < 3; ++k) {
        if (!isfinite(first_axis[k]) || !isfinite(second_axis[k]) ||
            fabs(first_axis[k] - (k == (size_t)(bs.spring_direction - 1))) > 1.e-12 ||
            fabs(second_axis[k] - first_axis[k]) > 1.e-12) {
            bs_fail("native mixed connector requires one matching global translation axis");
        }
    }
    if (!bs.actions_capturing) {
        return;
    }
    if (bs.actions.spring_seen) {
        bs_fail("repeated mixed connector action in one retained native frame");
    }
    for (k = 0; k < 3; ++k) {
        if (!isfinite(force[k]) || !isfinite(force[k + 3]) ||
            !isfinite(first_displacement[k]) || !isfinite(second_displacement[k])) {
            bs_fail("nonfinite native mixed connector force or translation");
        }
        bs.actions.spring[k] = force[k];
        bs.actions.spring2[k] = force[k + 3];
        bs.actions.displacement[k] = first_displacement[k];
        bs.actions.displacement2[k] = second_displacement[k];
    }
    bs.actions.spring_seen = 1;
}

/* Observe coefficients and the multiplier already calculated in the actual
 * native resultsforc loop. Its force elimination statements stay unchanged;
 * this callback neither solves nor projects any force vector. */
void bs_mpc_term(ITG row, ITG node, ITG direction, double coefficient, double multiplier)
{
    BSRigid* rigid;
    double force[3] = {0.}, moment[3], value;
    size_t r, k;
    if (!bs.active || bs.coupled < 2 || !bs.actions_capturing) {
        return;
    }
    if (row < 1 || row > bs.nmpc) {
        bs_fail("observed native MPC row is outside the proved graph");
    }
    if (!bs.rigid_row_index[row - 1]) {
        return;
    }
    r = (size_t)(bs.rigid_row_index[row - 1] - 1);
    rigid = bs_early.rigids + r;
    value = coefficient * multiplier;
    if (node < 1 || node > bs.nk || direction < 1 || direction > 3 ||
        !isfinite(coefficient) || !isfinite(multiplier) || !isfinite(value) ||
        ++bs.actions.rigid_terms[r] > 6) {
        bs_fail("invalid native rigid multiplier/term observation");
    }
    force[direction - 1] = value;
    if (node == rigid->receiver && direction == rigid->direction) {
        bs_cross(moment, bs.coordinates + 3 * (size_t)(node - 1), force);
        for (k = 0; k < 3; ++k) {
            bs.actions.receiving[k] += force[k];
            bs.actions.receiving_moment[k] += moment[k];
        }
    }
    else if (node == bs.reference_node && direction == rigid->direction) {
        for (k = 0; k < 3; ++k) {
            bs.actions.reference[k] += force[k];
        }
    }
    else if (node == bs.rotation_node) {
        bs.actions.couple[direction - 1] += value;
    }
    else if (node != rigid->auxiliary || direction != rigid->direction) {
        bs_fail("observed rigid MPC term differs from the proved physical/algebraic roles");
    }
    for (k = 0; k < 3; ++k) {
        if (!isfinite(bs.actions.receiving[k]) ||
            !isfinite(bs.actions.receiving_moment[k]) ||
            !isfinite(bs.actions.reference[k]) || !isfinite(bs.actions.couple[k])) {
            bs_fail("native rigid action accumulation overflow");
        }
    }
}

/* Called at the native resultsforc boundary after its existing MPC force
 * elimination and before its ordinary result restoration. The observer
 * neither projects a force vector nor modifies fn. The admitted point loads
 * must act only at free independent DOFs, so they have no contribution to
 * the native projected SPC residual. */
void bs_projected_supports(ITG nk, ITG mt, double* fn, ITG* nactdof)
{
    ITG node, direction, index, role, active;
    size_t a, k, r;
    BSSPC* spc;
    double force[3], moment[3], value;
    if (!bs.active || !bs.coupled || !bs.actions_capturing) {
        return;
    }
    if (bs.actions.support_seen || nk != bs.nk || mt < 4 || nk > INT_MAX / mt ||
        !bs.frame_displacements) {
        bs_fail("invalid or repeated native support output state");
    }
    for (direction = 1; direction <= 3; ++direction) {
        if (bs.pointload[direction - 1] != 0. &&
            nactdof[mt * (size_t)(bs.source_node - 1) + direction] <= 0) {
            bs_fail("coupled point loads require free independent native degrees of freedom");
        }
        if (bs.coupled == 2 &&
            (nactdof[mt * (size_t)(bs.reference_node - 1) + direction] <= 0 ||
             nactdof[mt * (size_t)(bs.rotation_node - 1) + direction] <= 0)) {
            bs_fail("mixed rigid reference and rotation modes must remain fully free native ports");
        }
        if (bs.coupled == 3 && direction == bs.spring_direction &&
            nactdof[mt * (size_t)(bs.reference_node - 1) + direction] <= 0) {
            bs_fail("contact scalar reference translation must remain a free native port");
        }
    }
    for (node = 1; node <= nk; ++node) {
        for (direction = 1; direction <= 3; ++direction) {
            index = mt * (node - 1) + direction;
            active = nactdof[index];
            if (active >= 0 || active % 2) {
                continue;
            }
            if (bs.coupled == 3 &&
                ((node == bs.reference_node && bs.guide_directions[direction - 1]) ||
                 (node == bs.rotation_node && bs.guide_directions[direction + 2]))) {
                int angle = node == bs.rotation_node;
                if (bs.actions.guide_spc_count >= 5 ||
                    bs.frame_displacements[index] != 0. || !isfinite(fn[index])) {
                    bs_fail("invalid physical rigid port guide output");
                }
                spc = bs.actions.guide_spcs + bs.actions.guide_spc_count++;
                *spc = (BSSPC){.node = node, .direction = direction,
                    .original_direction = direction + (angle ? 3 : 0),
                    .role = angle ? 2 : 1, .value = fn[index]};
                memset(force, 0, sizeof(force));
                memset(moment, 0, sizeof(moment));
                if (angle) {
                    moment[direction - 1] = fn[index];
                }
                else {
                    force[direction - 1] = fn[index];
                    bs_cross(moment, bs.coordinates + 3 * (size_t)(bs.reference_node - 1), force);
                }
                for (k = 0; k < 3; ++k) {
                    bs.actions.guide_force[k] += force[k];
                    bs.actions.guide_moment[k] += moment[k];
                    if (!isfinite(bs.actions.guide_force[k]) ||
                        !isfinite(bs.actions.guide_moment[k])) {
                        bs_fail("physical rigid guide wrench overflow");
                    }
                }
                continue;
            }
            if (bs.coupled >= 2 && bs.fixed_index[node - 1]) {
                if (bs.actions.solid_spc_count >= 3 * bs.fixed_count ||
                    bs.frame_displacements[index] != 0. || !isfinite(fn[index])) {
                    bs_fail("invalid actual physical tetrahedral support state");
                }
                value = fn[index];
                spc = bs.actions.solid_spcs + bs.actions.solid_spc_count++;
                *spc = (BSSPC){.node = node, .direction = direction, .role = 1, .value = value};
                memset(force, 0, sizeof(force));
                force[direction - 1] = value;
                bs_cross(moment, bs.coordinates + 3 * (size_t)(node - 1), force);
                for (k = 0; k < 3; ++k) {
                    bs.actions.solid_support[k] += force[k];
                    bs.actions.solid_moment[k] += moment[k];
                    if (!isfinite(bs.actions.solid_support[k]) ||
                        !isfinite(bs.actions.solid_moment[k])) {
                        bs_fail("native physical solid support wrench overflow");
                    }
                }
                continue;
            }
            if (bs.coupled >= 2) {
                for (r = 0; r < bs_early.rigid_count; ++r) {
                    BSRigid* rigid = bs_early.rigids + r;
                    if (node == rigid->auxiliary && direction == rigid->direction) {
                        if (bs.actions.rigid_spc_count >= bs_early.rigid_count ||
                            bs.frame_displacements[index] != 0. || !isfinite(fn[index])) {
                            bs_fail("invalid actual rigid algebraic prescription state");
                        }
                        bs.actions.rigid_spcs[bs.actions.rigid_spc_count++] =
                            (BSRigidSPC){node, direction, rigid->receiver, fn[index]};
                        break;
                    }
                }
                if (r != bs_early.rigid_count) {
                    continue;
                }
            }
            role = 0;
            a = bs_early.count;
            if (node == bs.support_node && bs.support_directions[direction - 1]) {
                role = 1;
            }
            else {
                for (a = 0; a < bs_early.count; ++a) {
                    if (node == bs_early.angles[a].auxiliary && direction <= 2) {
                        role = direction == 1 ? 2 : 3;
                        break;
                    }
                }
            }
            if (!role || bs.actions.spc_count == 9 || bs.frame_displacements[index] != 0. ||
                !isfinite(fn[index])) {
                bs_fail("unexpected native SPC identity, nonzero prescription or residual");
            }
            value = fn[index];
            spc = bs.actions.spcs + bs.actions.spc_count++;
            spc->node = node;
            spc->direction = direction;
            spc->original_direction = role == 1 ? direction : bs_early.angles[a].direction;
            spc->role = role;
            spc->value = value;
            memset(force, 0, sizeof(force));
            memset(moment, 0, sizeof(moment));
            if (role == 1) {
                force[direction - 1] = value;
                bs_cross(moment, bs.coordinates + 3 * (size_t)(node - 1), force);
            }
            else if (role == 2) {
                for (k = 0; k < 3; ++k) {
                    spc->axis[k] = bs_early.angles[a].axis[k];
                    moment[k] = value * spc->axis[k];
                }
            }
            /* The U-type homogeneous equation term is algebraic, not a
             * physical force or a second support couple. Retain its value
             * and identity, but do not add it to the structural wrench. */
            for (k = 0; k < 3; ++k) {
                bs.actions.support[k] += force[k];
                bs.actions.support_moment[k] += moment[k];
                if (!isfinite(bs.actions.support[k]) || !isfinite(bs.actions.support_moment[k])) {
                    bs_fail("native support wrench overflow");
                }
            }
        }
    }
    if (bs.actions.spc_count != 8) {
        bs_fail("native output must retain two translations and three angle/algebraic pairs");
    }
    if (bs.coupled == 3 && bs.actions.guide_spc_count != 5) {
        bs_fail("physical rigid guide requires all five actual native reactions");
    }
    if (bs.coupled >= 2) {
        if (bs.actions.solid_spc_count != 3 * bs.fixed_count ||
            bs.actions.rigid_spc_count != bs_early.rigid_count) {
            bs_fail("actual native mixed physical/algebraic support catalogue is incomplete");
        }
        for (r = 0; r < bs_early.rigid_count; ++r) {
            if (bs.actions.rigid_terms[r] != 6) {
                bs_fail("actual native rigid graph action observation is incomplete");
            }
        }
        bs_cross(bs.actions.reference_moment,
                 bs.coordinates + 3 * (size_t)(bs.reference_node - 1), bs.actions.reference);
        for (k = 0; k < 3; ++k) {
            bs.actions.reference_moment[k] += bs.actions.couple[k];
            if (!isfinite(bs.actions.reference_moment[k])) {
                bs_fail("native rigid reference moment overflow");
            }
        }
    }
    bs.actions.support_seen = 1;
}

void bs_begin_results(ITG iout, ITG step, ITG increment, double time)
{
    if (!bs.active) {
        return;
    }
    bs.capturing = 0;
    bs.mapping = 0;
    /* Linear static writes its retained final result with iout=1;
     * nonlinear retained evaluations use iout=2. Actual FRD binding below
     * is required in either case; a computed map alone is not a frame. */
    if (iout != 1 && iout != 2) {
        return;
    }
    if (bs.pending || bs.current || step != 1 || increment < 1 ||
        !isfinite(time) || time <= 0. || time > bs.end_time) {
        bs_fail("invalid or unconsumed retained native result evaluation");
    }
    if (bs.coupled && (!bs.actions_capturing || !bs.actions.spring_seen ||
                       !bs.actions.support_seen || bs.action_step != step ||
                       bs.action_increment != increment || bs.action_time != time)) {
        bs_fail("native beam and physical-action observations do not share one retained frame");
    }
    if (bs.coupled == 3 && !bs.actions.contact_seen) {
        bs_fail("native beam and contact diagnostics do not share one retained frame");
    }
    bs.actions_capturing = 0;
    bs.frame_displacements = NULL;
    memset(bs.samples, 0, bs_product(bs_product((size_t)bs.ne, 2), sizeof(BSSample)));
    bs.step = step;
    bs.increment = increment;
    bs.time = time;
    bs.mapped = 0;
    bs.pending = 1;
    bs.capturing = 1;
}

void FORTRAN(bs_map_begin, ())
{
    if (!bs.active || !bs.capturing) {
        return;
    }
    if (bs.mapping || bs.mapped) {
        bs_fail("duplicate native stress-section map");
    }
    bs.mapping = 1;
}

ITG FORTRAN(bs_mapping_active, ())
{
    return bs.active && bs.mapping;
}

static double bs_dot(const double* first, const double* second)
{
    return first[0] * second[0] + first[1] * second[1] + first[2] * second[2];
}

void FORTRAN(bs_end_begin, (ITG* element, ITG* node, ITG* end,
                            double* position, double* e1, double* e2, double* normal))
{
    BSSample* sample;
    size_t k, slot;
    if (!bs.active || !bs.mapping) {
        return;
    }
    if (bs.current || *element < 1 || *element > bs.ne ||
        (*end != 1 && *end != 3) || !bs.elements[*element - 1].declared) {
        bs_fail("invalid native beam/end observation");
    }
    slot = 2 * (size_t)(*element - 1) + (*end == 3);
    sample = bs.samples + slot;
    if (sample->seen || *node != bs.elements[*element - 1].nodes[*end - 1]) {
        bs_fail("duplicate end or mismatched native beam node");
    }
    sample->element = *element;
    sample->node = *node;
    sample->end = *end;
    for (k = 0; k < 3; ++k) {
        if (!isfinite(position[k]) || !isfinite(e1[k]) ||
            !isfinite(e2[k]) || !isfinite(normal[k])) {
            bs_fail("nonfinite native section centroid or projection axis");
        }
        sample->position[k] = position[k];
        sample->e1[k] = e1[k];
        sample->e2[k] = e2[k];
        sample->normal[k] = normal[k];
    }
    if (fabs(bs_dot(e1, e1) - 1.) > 1.e-8 || fabs(bs_dot(e2, e2) - 1.) > 1.e-8 ||
        fabs(bs_dot(normal, normal) - 1.) > 1.e-8 || fabs(bs_dot(e1, e2)) > 1.e-8 ||
        fabs(bs_dot(e1, normal)) > 1.e-8 || fabs(bs_dot(e2, normal)) > 1.e-8) {
        bs_fail("native section axes are not finite orthonormal projection directions");
    }
    bs.current = sample;
}

void FORTRAN(bs_end_point, (double* force_increment, double* moment_increment))
{
    BSSample* sample = bs.current;
    size_t k;
    if (!bs.active || !bs.mapping) {
        return;
    }
    if (!sample || sample->points == INT_MAX) {
        bs_fail("native section point outside an active end observation");
    }
    for (k = 0; k < 3; ++k) {
        if (!isfinite(force_increment[k]) || !isfinite(moment_increment[k])) {
            bs_fail("nonfinite native section force or moment increment");
        }
        sample->force[k] += force_increment[k];
        sample->moment[k] += moment_increment[k];
        if (!isfinite(sample->force[k]) || !isfinite(sample->moment[k])) {
            bs_fail("native section integral overflow");
        }
    }
    ++sample->points;
}

void FORTRAN(bs_end_finish, ())
{
    BSSample* sample = bs.current;
    size_t k;
    if (!bs.active || !bs.mapping) {
        return;
    }
    if (!sample || sample->points < 1) {
        bs_fail("empty native section integration");
    }
    sample->channels[0] = bs_dot(sample->e1, sample->force);
    sample->channels[1] = bs_dot(sample->e2, sample->force);
    sample->channels[2] = bs_dot(sample->normal, sample->force);
    sample->channels[3] = bs_dot(sample->normal, sample->moment);
    sample->channels[4] = bs_dot(sample->e2, sample->moment);
    sample->channels[5] = bs_dot(sample->e1, sample->moment);
    for (k = 0; k < 6; ++k) {
        if (!isfinite(sample->channels[k])) {
            bs_fail("nonfinite native local resultant projection");
        }
    }
    sample->seen = 1;
    bs.current = NULL;
}

void FORTRAN(bs_map_end, ())
{
    ITG element;
    size_t count = 0;
    if (!bs.active || !bs.capturing) {
        return;
    }
    if (!bs.mapping || bs.current) {
        bs_fail("incomplete native stress-section map");
    }
    for (element = 0; element < bs.ne; ++element) {
        if (bs.elements[element].declared) {
            if (!bs.samples[2 * (size_t)element].seen ||
                !bs.samples[2 * (size_t)element + 1].seen) {
                bs_fail("missing native B32R end observation");
            }
            count += 2;
        }
    }
    if (count != 2 * bs.count) {
        bs_fail("native sample catalogue mismatch");
    }
    bs.mapping = 0;
    bs.mapped = 1;
    bs.capturing = 0;
}

static void bs_vector(FILE* stream, const double* value)
{
    fprintf(stream, "[%.17g,%.17g,%.17g]", value[0], value[1], value[2]);
}

static void bs_write_spring2(FILE* stream, const BSActions* actions)
{
    ITG end, node;
    size_t k;
    double force[3], moment[3];
    const double *resisting, *displacement;
    fprintf(stream, "},\"spring\":{\"owner\":\"%s\",\"element\":%d,\"ends\":[",
            bs.spring_owner, bs.spring_element);
    for (end = 1; end <= 2; ++end) {
        node = end == 1 ? bs.spring_node : bs.reference_node;
        resisting = end == 1 ? actions->spring : actions->spring2;
        displacement = end == 1 ? actions->displacement : actions->displacement2;
        fprintf(stream, "%s{\"end\":%d,\"node\":%d,\"role\":\"%s\",\"position\":",
                end == 1 ? "" : ",", end, node,
                end == 1 ? "BEAM_VERTEX" : "RBE_REFERENCE");
        bs_vector(stream, bs.coordinates + 3 * (size_t)(node - 1));
        fprintf(stream, ",\"native_resisting_force\":");
        bs_vector(stream, resisting);
        for (k = 0; k < 3; ++k) {
            force[k] = -resisting[k];
        }
        bs_cross(moment, bs.coordinates + 3 * (size_t)(node - 1), force);
        fprintf(stream, ",\"force_global\":");
        bs_vector(stream, force);
        fprintf(stream, ",\"moment_origin\":");
        bs_vector(stream, moment);
        fprintf(stream, ",\"displacement\":");
        bs_vector(stream, displacement);
        fprintf(stream, "}");
    }
    fprintf(stream, "]");
}

static void bs_write_mixed_extra(FILE* stream, const BSActions* actions)
{
    size_t row;
    fprintf(stream, ",\"solid_support\":{\"owner\":\"%s\",\"nodes\":[", bs.fixed_owner);
    for (row = 0; row < bs.fixed_count; ++row) {
        fprintf(stream, "%s%d", row ? "," : "", bs.fixed_nodes[row]);
    }
    fprintf(stream, "],\"force_global\":");
    bs_vector(stream, actions->solid_support);
    fprintf(stream, ",\"moment_origin\":");
    bs_vector(stream, actions->solid_moment);
    fprintf(stream, ",\"spcs\":[");
    for (row = 0; row < actions->solid_spc_count; ++row) {
        const BSSPC* spc = actions->solid_spcs + row;
        fprintf(stream, "%s{\"node\":%d,\"direction\":%d,\"role\":\"TRANSLATION\","
                "\"value\":%.17g,\"position\":", row ? "," : "", spc->node,
                spc->direction, spc->value);
        bs_vector(stream, bs.coordinates + 3 * (size_t)(spc->node - 1));
        fprintf(stream, "}");
    }
    fprintf(stream, "]},\"port\":{\"owner\":\"%s\",\"reference_node\":%d,"
            "\"rotation_node\":%d,\"receiving_nodes\":[", bs.port_owner,
            bs.reference_node, bs.rotation_node);
    for (row = 0; row < bs.receiver_count; ++row) {
        fprintf(stream, "%s%d", row ? "," : "", bs.receivers[row]);
    }
    fprintf(stream, "],\"receiving_action\":{\"force_global\":");
    bs_vector(stream, actions->receiving);
    fprintf(stream, ",\"moment_origin\":");
    bs_vector(stream, actions->receiving_moment);
    fprintf(stream, "},\"reference_action\":{\"force_global\":");
    bs_vector(stream, actions->reference);
    fprintf(stream, ",\"couple_global\":");
    bs_vector(stream, actions->couple);
    fprintf(stream, ",\"moment_origin\":");
    bs_vector(stream, actions->reference_moment);
    fprintf(stream, "},\"algebraic_spcs\":[");
    for (row = 0; row < actions->rigid_spc_count; ++row) {
        const BSRigidSPC* spc = actions->rigid_spcs + row;
        fprintf(stream, "%s{\"node\":%d,\"direction\":%d,\"receiving_node\":%d,"
                "\"role\":\"ALGEBRAIC\",\"value\":%.17g}", row ? "," : "",
                spc->node, spc->direction, spc->receiving_node, spc->value);
    }
    fprintf(stream, "]}");
}

static void bs_write_contact_extra(FILE* stream, const BSActions* actions)
{
    size_t row, side;
    fprintf(stream, ",\"port_guide\":{\"owner\":\"%s\",\"reference_node\":%d,"
            "\"rotation_node\":%d,\"force_global\":", bs.guide_owner,
            bs.reference_node, bs.rotation_node);
    bs_vector(stream, actions->guide_force);
    fprintf(stream, ",\"moment_origin\":");
    bs_vector(stream, actions->guide_moment);
    fprintf(stream, ",\"spcs\":[");
    for (row = 0; row < actions->guide_spc_count; ++row) {
        const BSSPC* spc = actions->guide_spcs + row;
        fprintf(stream, "%s{\"node\":%d,\"direction\":%d,\"role\":\"%s\","
                "\"value\":%.17g}", row ? "," : "", spc->node, spc->direction,
                spc->role == 1 ? "TRANSLATION" : "ANGLE", spc->value);
    }
    fprintf(stream, "]},\"contact_sides\":[");
    for (side = 0; side < 2; ++side) {
        fprintf(stream, "%s{\"owner\":\"%s\",\"solid_owner\":\"%s\","
                "\"side\":\"%s\",\"force_global\":", side ? "," : "",
                bs.contact_owner, bs.contact_solid_owner[side], side ? "MASTER" : "SLAVE");
        bs_vector(stream, actions->contact_force[side]);
        fprintf(stream, ",\"moment_origin\":");
        bs_vector(stream, actions->contact_moment[side]);
        fprintf(stream, "}");
    }
    fprintf(stream, "]");
}

static void bs_write_actions(FILE* stream, const BSActions* actions)
{
    double force[3], moment[3];
    size_t k, row;
    const char* roles[] = {"", "TRANSLATION", "ANGLE", "ALGEBRAIC"};
    fprintf(stream, ",\"native_actions\":{\"position_frame\":\"ORIGINAL_GLOBAL\","
            "\"moment_reference\":\"GLOBAL_ORIGIN\",\"force_action\":\"ON_STRUCTURAL_MODEL\","
            "\"source\":{\"owner\":\"%s\",\"node\":%d,\"position\":",
            bs.source_owner, bs.source_node);
    bs_vector(stream, bs.coordinates + 3 * (size_t)(bs.source_node - 1));
    if (bs.coupled == 3) {
        fprintf(stream, ",\"kind\":\"POINT_FORCE\"");
    }
    fprintf(stream, ",\"force_global\":");
    bs_vector(stream, actions->source);
    fprintf(stream, ",\"moment_origin\":");
    bs_vector(stream, actions->source_moment);
    if (bs.coupled >= 2) {
        bs_write_spring2(stream, actions);
    }
    else {
        fprintf(stream, "},\"spring\":{\"owner\":\"%s\",\"element\":%d,\"node\":%d,\"position\":",
                bs.spring_owner, bs.spring_element, bs.spring_node);
        bs_vector(stream, bs.coordinates + 3 * (size_t)(bs.spring_node - 1));
        fprintf(stream, ",\"native_resisting_force\":");
        bs_vector(stream, actions->spring);
        for (k = 0; k < 3; ++k) {
            force[k] = -actions->spring[k];
            moment[k] = -actions->spring_moment[k];
        }
        fprintf(stream, ",\"force_global\":");
        bs_vector(stream, force);
        fprintf(stream, ",\"moment_origin\":");
        bs_vector(stream, moment);
        fprintf(stream, ",\"displacement\":");
        bs_vector(stream, actions->displacement);
    }
    fprintf(stream, "},\"support\":{\"owner\":\"%s\",\"node\":%d,\"position\":",
            bs.support_owner, bs.support_node);
    bs_vector(stream, bs.coordinates + 3 * (size_t)(bs.support_node - 1));
    fprintf(stream, ",\"force_global\":");
    bs_vector(stream, actions->support);
    fprintf(stream, ",\"moment_origin\":");
    bs_vector(stream, actions->support_moment);
    fprintf(stream, ",\"spcs\":[");
    for (row = 0; row < actions->spc_count; ++row) {
        const BSSPC* spc = actions->spcs + row;
        fprintf(stream, "%s{\"node\":%d,\"direction\":%d,\"role\":\"%s\","
                "\"original_node\":%d,\"original_direction\":%d,\"value\":%.17g",
                row ? "," : "", spc->node, spc->direction, roles[spc->role],
                bs.support_node, spc->original_direction, spc->value);
        if (spc->role == 2) {
            fprintf(stream, ",\"axis\":");
            bs_vector(stream, spc->axis);
        }
        fprintf(stream, "}");
    }
    fprintf(stream, "]}");
    if (bs.coupled >= 2) {
        bs_write_mixed_extra(stream, actions);
    }
    if (bs.coupled == 3) {
        bs_write_contact_extra(stream, actions);
    }
    fprintf(stream, "}");
}

static void bs_write(void)
{
    char* output = bs_suffix(".out");
    char* temporary = bs_suffix(".out.tmp");
    FILE* stream = fopen(temporary, "wx");
    size_t frame, row;
    int bad;
    if (!stream) {
        bs_fail("cannot exclusively create native observer output");
    }
    /* The mapper's co+vold geometry can be a preceding/reference state in
     * linstatic. Preserve V1's legacy labels while stating the actual source. */
    fprintf(stream, "{\"schema\":\"CCX_BEAM_SECTION_V%d\",\"request\":\"%s\","
            "\"complete\":%s,\"units\":{\"length\":\"mm\",\"force\":\"N\",\"moment\":\"N*mm\"},"
            "\"position_frame\":\"%s\",\"basis_frame\":\"%s\","
            "\"geometry_source\":\"CO_PLUS_NATIVE_MAP_VOLD_ARGUMENT\","
            "\"sample_identity_scope\":\"ELEMENT_END_BEFORE_NODE_AVERAGING\","
            "\"moment_reference\":\"NATIVE_SECTION_CENTROID\","
            "\"force_action\":\"OUTWARD_NATIVE_ELEMENT_END_FACE\","
            "\"native_channels_method\":\"PROJECTED_NATIVE_FORCE_AND_MOMENT_INCREMENT_SUM\","
            "\"completion_requires_successful_child\":true",
            bs.coupled + 1, bs.request,
            bs.frames[bs.frame_count - 1].time == bs.end_time ? "true" : "false",
            bs.coupled ? "NATIVE_MAP_EXPANDED_SECTION" : "CURRENT_EXPANDED_SECTION",
            bs.coupled ? "NATIVE_MAP_FACE_BASIS" : "NATIVE_CURRENT_FACE_BASIS");
    if (bs.coupled == 3) {
        fprintf(stream, ",\"contact_request\":\"%s\"", bs.contact_request);
    }
    fprintf(stream, ",\"frames\":[");
    for (frame = 0; frame < bs.frame_count; ++frame) {
        BSFrame* item = bs.frames + frame;
        int first = 1;
        fprintf(stream, "%s{\"step\":%d,\"increment\":%d,\"frame\":%d,\"time\":%.17g,"
                "\"complete\":true", frame ? "," : "",
                item->step, item->increment, item->dataset, item->time);
        if (bs.coupled == 3) {
            fprintf(stream, ",\"contact_request\":\"%s\"", bs.contact_request);
        }
        fprintf(stream, ",\"samples\":[");
        for (row = 0; row < 2 * (size_t)bs.ne; ++row) {
            BSSample* sample = item->samples + row;
            if (!sample->seen) {
                continue;
            }
            fprintf(stream, "%s{\"element\":%d,\"node\":%d,\"end\":%d,\"position\":",
                    first ? "" : ",", sample->element, sample->node, sample->end);
            first = 0;
            bs_vector(stream, sample->position);
            fprintf(stream, ",\"force_global\":");
            bs_vector(stream, sample->force);
            fprintf(stream, ",\"moment_global\":");
            bs_vector(stream, sample->moment);
            fprintf(stream, ",\"basis\":{\"e1\":");
            bs_vector(stream, sample->e1);
            fprintf(stream, ",\"e2\":");
            bs_vector(stream, sample->e2);
            fprintf(stream, ",\"normal\":");
            bs_vector(stream, sample->normal);
            fprintf(stream, "},\"native_channels\":{\"shear1\":%.17g,\"shear2\":%.17g,"
                    "\"axial\":%.17g,\"torque\":%.17g,\"bend2\":%.17g,\"bend1\":%.17g}}",
                    sample->channels[0], sample->channels[1], sample->channels[2],
                    sample->channels[3], sample->channels[4], sample->channels[5]);
        }
        fprintf(stream, "]");
        if (bs.coupled) {
            bs_write_actions(stream, &item->actions);
        }
        fprintf(stream, "}");
    }
    fprintf(stream, "]}\n");
    bad = ferror(stream);
    if (fclose(stream)) {
        bad = 1;
    }
    if (bad || rename(temporary, output)) {
        bs_fail("cannot atomically publish native observer output");
    }
    free(output);
    free(temporary);
}

void bs_frd_frame(ITG dataset, ITG step, ITG increment, double time)
{
    BSFrame* replacement;
    BSFrame* frame;
    if (!bs.active) {
        return;
    }
    if (!bs.pending || !bs.mapped || bs.mapping || bs.current || dataset < 1 ||
        step != bs.step || increment != bs.increment || time != bs.time) {
        bs_fail("FRD stress dataset differs from the observed native output evaluation");
    }
    if (bs.frame_count &&
        (dataset <= bs.frames[bs.frame_count - 1].dataset ||
         increment < bs.frames[bs.frame_count - 1].increment ||
         time < bs.frames[bs.frame_count - 1].time)) {
        bs_fail("nonmonotonic native FRD frame identity");
    }
    if (bs.frame_count == SIZE_MAX) {
        bs_fail("native frame count overflow");
    }
    replacement = realloc(bs.frames, bs_product(bs.frame_count + 1, sizeof(BSFrame)));
    if (!replacement) {
        bs_fail("native frame allocation failed");
    }
    bs.frames = replacement;
    frame = bs.frames + bs.frame_count++;
    frame->step = step;
    frame->increment = increment;
    frame->dataset = dataset;
    frame->time = time;
    frame->samples = bs_allocate(bs_product((size_t)bs.ne, 2), sizeof(BSSample));
    memcpy(frame->samples, bs.samples,
           bs_product(bs_product((size_t)bs.ne, 2), sizeof(BSSample)));
    frame->actions = bs.actions;
    bs.pending = 0;
    bs_write();
}
