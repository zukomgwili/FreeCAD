    def test_diagnostics_on_off_preserves_native_mechanics_and_v3_accounting(self):
        # The native results/stiffness/Spooles controls permit deterministic
        # single-worker comparison, not a new numerical acceptance tolerance.
        controls = ("CCX_NPROC_RESULTS", "CCX_NPROC_STIFFNESS", "CCX_NPROC_EQUATION_SOLVER")
        previous = {key: os.environ.get(key) for key in controls}

        def restore_environment():
            for key, value in previous.items():
                if value is None:
                    os.environ.pop(key, None)
                else:
                    os.environ[key] = value

        self.addCleanup(restore_environment)
        for key in controls:
            os.environ[key] = "1"
        model = self.make_case(accounting=True)

        def accounting():
            current = [item for item in model.analysis.Group
                       if getattr(getattr(item, "Proxy", None), "Type", "")
                       == "Fem::NativeForceAccountingResult" and item.Status.startswith("Current")]
            self.assertEqual(len(current), 1)
            data = json.loads(current[0].AccountingData)
            self.assertEqual(data["schema"], "CCX_FORCE_ACCOUNTING_V3")
            self.assertEqual(data["movement_source"]["status"], "BOUND")
            self.assertAlmostEqual(abs(data["wrenches"]["SUPPORT"][model.fixed.Name][0]),
                                   0.9950248756218906, delta=0.01)
            return current[0], data

        report, enabled_data = accounting()
        deck = Path(model.fea.inp_file_name)
        def mechanical_frd():
            # Only native creation timestamps are nonmechanical metadata.
            return [line for line in deck.with_suffix(".frd").read_bytes().splitlines()
                    if not line.startswith((b"    1UDATE ", b"    1UTIME "))]

        frd = mechanical_frd()
        dat = deck.with_suffix(".dat").read_text()
        # Existing pair-resultant blocks are literal native output, not sums
        # reconstructed from the new diagnostic integration-point samples.
        pair_totals = dat[dat.index(" statistics for slave set"):]
        self.assertEqual(deck.read_text().count("CF, CFN, CFS\n"), 1)
        model.solver.NativeContactOutputs = []
        model.fea.write_inp_file()
        self.assertFalse(report.Status.startswith("Current"))
        self.assertEqual(model.fea.ccx_run(), 0)
        self.assertEqual(mechanical_frd(), frd)
        without = deck.with_suffix(".dat").read_text()
        self.assertEqual(without[without.index(" statistics for slave set"):], pair_totals)
        self.assertNotIn("*CONTACT PRINT\nCDIS, CSTR\n", deck.read_text())
        self.assertEqual(deck.read_text().count("CF, CFN, CFS\n"), 1)
        _report, disabled_data = accounting()
        self.assertEqual(disabled_data["wrenches"], enabled_data["wrenches"])
        with self.assertRaises(ValueError):
            model.result.Proxy.getContactStates(model.result)

    def test_rotated_sliding_basis_retains_native_global_normal_and_plastic_vector(self):
        model = self.make_case(tangent="0.005 mm", rotation=App.Rotation(App.Vector(0, 0, 1), 90))
        sliding = [row for row in model.data["frames"][-1]["samples"]
                   if row["availability"] == "ACTIVE" and row["state"] == "SLIP"]
        self.assertTrue(sliding)
        for row in sliding:
            normal = row["normal"]
            self.assertAlmostEqual(abs(normal[1]), 1, delta=1e-10)
            self.assertAlmostEqual(normal[0], 0, delta=1e-10)
            self.assertAlmostEqual(normal[2], 0, delta=1e-10)
            plastic = row["plastic_slip_vector"]
            self.assertAlmostEqual(sum(x * y for x, y in zip(normal, plastic)), 0, delta=1e-10)
            self.assertAlmostEqual(math.hypot(*plastic), row["plastic_slip_increment"], delta=1e-12)
            self.assertGreater(row["pressure"], 0)

    def test_retargeted_selected_solver_symlink_withdraws_old_binary_binding(self):
        model = self.make_case()
        original = Path(model.data["provenance"]["binary"])
        link = self.directory / "selected-solver"
        link.symlink_to(original)
        model.solver.NativeAccountingSolver = str(link)
        model.fea.write_inp_file()
        self.assertEqual(model.fea.ccx_run(), 0)
        literal = model.result.ContactData
        different = self.directory / "other-solver"
        shutil.copy2(original, different)
        link.unlink()
        link.symlink_to(different)
        with self.assertRaises(ValueError):
            model.result.Proxy.getContactStates(model.result)
        self.assertEqual(model.result.ContactData, literal)

    def test_inconsistent_native_frame_and_sample_contracts_are_refused(self):
        from femtools import contact_state

        model = self.make_case()
        source = model.data["provenance"]
        native = {key: value for key, value in model.data.items() if key != "provenance"}
        self.assertEqual(contact_state._validate_output(copy.deepcopy(native), source), native)
        for mutation in ("final incomplete", "missing sample", "duplicate sample", "wrong token",
                         "nonfinite pressure", "wrong master", "bad basis", "missing face"):
            with self.subTest(mutation=mutation):
                data = copy.deepcopy(native)
                frame = data["frames"][-1]
                row = frame["samples"][0]
                if mutation == "final incomplete":
                    frame["time"] -= 5e-13
                    frame["complete"] = False
                elif mutation == "missing sample":
                    frame["samples"].pop()
                elif mutation == "duplicate sample":
                    frame["samples"].append(copy.deepcopy(row))
                elif mutation == "wrong token":
                    data["request"] = "0" * 32
                elif mutation == "nonfinite pressure":
                    row["pressure"] = float("nan")
                elif mutation == "wrong master":
                    row["master_element"] = 2147483647
                elif mutation == "bad basis":
                    row["normal"] = [2, 0, 0]
                else:
                    data["face_inventory"].pop()
                with self.assertRaises(ValueError):
                    contact_state._validate_output(data, source)
