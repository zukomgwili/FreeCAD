plan={'schema':'FreeCAD-e4k-installed-test-plan-v1','counts':{'cmd':22,'gui':1,'cold':1},'expected_ids':{k:sorted(v) for k,v in ids.items()},'cmd_modules':rows,'native_solve_endpoints':15,'no_skips':True,'source_or_build_import_override':False,'native_solver_override':False,'identity_before_fixtures':True,'frozen_oracles_sha256':'ba8e0b883a501d9306c4bdab77936dc4c5827c1b061d97ccb03859ebf9ff9548'}
(ROOT/'e4k-test-plan.json').write_text(json.dumps(plan,indent=2)+'\n')
old=(OLD/'AppBeamBjh.py').read_text();tree=ast.parse(old)
funcs={n.name:ast.get_source_segment(old,n) for n in tree.body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
common={
 'femobjects.solver_calculix':'femobjects/solver_calculix.py',
 'femsolver.calculix.write_step_equation':'femsolver/calculix/write_step_equation.py',
