from pathlib import Path
import ast
import json

ROOT = Path('/private/tmp/freecad-e4k-install-lgmq96_q')
REPO = Path('/Users/zukomgwili/src/FreeCAD')
OLD = Path('/private/tmp/freecad-bjh-install-4X8KjpF5')
MODULES = [
 ('femtest.app.test_static_step_amplitude','TestStaticStepAmplitude'),
 ('femtest.app.test_contact_state_catalogue','TestContactStateCatalogue'),
 ('femtest.app.test_staged_selfweight_native','TestStagedSelfweightNative'),
]
rows=[]
for name,cls in MODULES:
 tree=ast.parse((REPO/'src/Mod/Fem'/(name.replace('.','/')+'.py')).read_text())
 klass=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name==cls)
 methods=sorted(n.name for n in klass.body if isinstance(n,ast.FunctionDef) and n.name.startswith('test_'))
 rows.append({'module':name,'class':cls,'methods':methods})
assert [len(r['methods']) for r in rows]==[8,8,5]
identity_id='AppStagedE4k.AppE4kIdentity.test_exact_application_identity_native_origins_and_default_solver'
ids={'cmd':[identity_id]+[r['module']+'.'+r['class']+'.'+m for r in rows for m in r['methods']],
     'gui':['GuiStagedE4k.TestE4kGui.test_visible_step_property_and_stock_solver_buttons_qualify_current_equilibrium'],
